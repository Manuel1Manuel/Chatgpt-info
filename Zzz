  ctx.fillStyle=glow;
  ctx.beginPath();ctx.ellipse(-s*.52,0,glowR,glowR*.55,0,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='rgba(0,0,0,.32)';
  ctx.beginPath();ctx.ellipse(0,s*.1,s*.55,s*.2,0,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#39434b';
  ctx.beginPath();
  ctx.moveTo(s*.62,0);
  ctx.quadraticCurveTo(s*.2,-s*.42,-s*.5,-s*.22);
  ctx.quadraticCurveTo(-s*.66,0,-s*.5,s*.22);
  ctx.quadraticCurveTo(s*.2,s*.42,s*.62,0);
  ctx.closePath();ctx.fill();
  ctx.fillStyle='#6d7c86';
  ctx.beginPath();
  ctx.moveTo(s*.5,0);
  ctx.quadraticCurveTo(s*.14,-s*.3,-s*.38,-s*.16);
  ctx.quadraticCurveTo(-s*.06,-s*.04,s*.5,0);
  ctx.closePath();ctx.fill();
  ctx.fillStyle='#262e33';
  ctx.beginPath();ctx.moveTo(-s*.1,-s*.22);ctx.lineTo(-s*.4,-s*.52);ctx.lineTo(-s*.22,-s*.17);ctx.closePath();ctx.fill();
  ctx.beginPath();ctx.moveTo(-s*.1,s*.22);ctx.lineTo(-s*.4,s*.52);ctx.lineTo(-s*.22,s*.17);ctx.closePath();ctx.fill();
  ctx.fillStyle='#163e49';
  ctx.beginPath();ctx.ellipse(s*.13,0,s*.17,s*.14,0,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#5fd8ef';
  ctx.beginPath();ctx.ellipse(s*.16,0,s*.1,s*.08,0,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#e4fcff';
  ctx.beginPath();ctx.ellipse(s*.19,-s*.03,s*.04,s*.03,0,0,Math.PI*2);ctx.fill();
  ctx.restore();
}
function gzRenderFrame(){
  if(!gzMap||!gzRaster)return;
  const ctx=gzCanvas.getContext('2d',{alpha:false});
  ctx.setTransform(gzDpr,0,0,gzDpr,0,0);
  ctx.fillStyle='#090d11';ctx.fillRect(0,0,gzViewW,gzViewH);
  const scale=gzFitScale*gzZoom;
  ctx.imageSmoothingEnabled=false;
  ctx.translate(gzViewW/2,gzViewH/2);
  ctx.scale(scale,scale);
  ctx.translate(-gzCameraX*GZ_TILE,-gzCameraY*GZ_TILE);
  ctx.drawImage(gzRaster,0,0);
  const gzNow=performance.now();
  gzDrawPlacedBlocks(ctx,gzNow);
  gzDrawPlayer(ctx,gzNow);
  gzDrawGhost(ctx);
  ctx.setTransform(gzDpr,0,0,gzDpr,0,0);
  document.getElementById('gz-zoom-label').textContent=Math.round(gzZoom*100)+' %';
}
function gzFrame(time){
  if(!document.getElementById('scr-groundzero').classList.contains('show')){gzLastFrame=time;gzFrameHandle=requestAnimationFrame(gzFrame);return;}
  if(!gzMap||!gzRaster){gzFrameHandle=requestAnimationFrame(gzFrame);return;}
  const dt=Math.min(.05,Math.max(0,(time-(gzLastFrame||time))/1000));gzLastFrame=time;
  const zoomIn=(gzKeys.has('arrowup')||gzKeys.has('arrowright'))?1:0;
  const zoomOut=(gzKeys.has('arrowdown')||gzKeys.has('arrowleft'))?1:0;
  if(zoomIn!==zoomOut&&dt>0)gzTargetZoom=gzClamp(gzTargetZoom*Math.exp((zoomIn?1:-1)*.85*dt),.35,10);
  const smoothing=1-Math.exp(-dt*10);
  gzZoom+=(gzTargetZoom-gzZoom)*smoothing;
  let ix=0,iy=0;
  if(gzKeys.has('a'))ix-=1;if(gzKeys.has('d'))ix+=1;
  if(gzKeys.has('w'))iy-=1;if(gzKeys.has('s'))iy+=1;
  if(ix||iy){const mag=Math.hypot(ix,iy);ix/=mag;iy/=mag;}
  if(gzPlayerReady){
    const accel=24,maxSpeed=6.8,damping=Math.exp(-dt*5.5);
    gzPlayerVX=(gzPlayerVX+ix*accel*dt)*damping;
    gzPlayerVY=(gzPlayerVY+iy*accel*dt)*damping;
    const speedNow=Math.hypot(gzPlayerVX,gzPlayerVY);
    if(speedNow>maxSpeed){gzPlayerVX=gzPlayerVX/speedNow*maxSpeed;gzPlayerVY=gzPlayerVY/speedNow*maxSpeed;}
    gzPlayerX+=gzPlayerVX*dt;gzPlayerY+=gzPlayerVY*dt;
    if(gzMap){gzPlayerX=gzClamp(gzPlayerX,.5,gzMap.width-.5);gzPlayerY=gzClamp(gzPlayerY,.5,gzMap.height-.5);}
    if(ix||iy){
      gzCameraManual=false;
      const targetAngle=Math.atan2(iy,ix);
      let diff=targetAngle-gzPlayerAngle;
      while(diff>Math.PI)diff-=Math.PI*2;
      while(diff<-Math.PI)diff+=Math.PI*2;
      gzPlayerAngle+=diff*Math.min(1,dt*9);
    }
    if(!gzCameraManual){
      const follow=Math.min(1,dt*4.2);
      gzCameraX+=(gzPlayerX-gzCameraX)*follow;
      gzCameraY+=(gzPlayerY-gzCameraY)*follow;
      if(gzMap){gzCameraX=gzClamp(gzCameraX,0,gzMap.width);gzCameraY=gzClamp(gzCameraY,0,gzMap.height);}
    }
  }
  gzRenderFrame();
  gzFrameHandle=requestAnimationFrame(gzFrame);
}
async function openGroundZeroGame(){
  showScreen('groundzero');
  gzKeys.clear();
  if(!gzMap&&!gzLoading&&!gzLoadFailed)await gzLoadMap();
  gzResize();
  if(!gzFrameHandle)gzFrameHandle=requestAnimationFrame(gzFrame);
}
function closeGroundZeroGame(){
  gzKeys.clear();
  showScreen('sectors');
}
async function gzLoadMap(){
  gzLoading=true;
  const status=document.getElementById('gz-map-status');
  const error=document.getElementById('gz-map-error');
  error.hidden=true;
  status.textContent='Originaldatei wird gelesen…';
  try{
    gzMap=await gzReadOriginalMap();
    status.textContent='Original-Kacheln · Save v'+gzMap.version+' · eingebettet';
    document.getElementById('gz-map-size').textContent=gzMap.width+' × '+gzMap.height;
    gzCameraX=gzMap.width/2;gzCameraY=gzMap.height/2;
    gzCoreSpawn=null;gzPlayerReady=false;
    gzFitScale=Math.min(window.innerWidth/(gzMap.width*GZ_TILE),window.innerHeight/(gzMap.height*GZ_TILE))*.88;
    gzZoom=1;gzTargetZoom=1;
    const nativeCanvas=document.createElement('canvas');
    nativeCanvas.width=gzMap.width*GZ_TILE;nativeCanvas.height=gzMap.height*GZ_TILE;
    const nativeCtx=nativeCanvas.getContext('2d',{alpha:false});
    const activeContext=gzCtx;
    gzSetRenderContext(nativeCtx);
    const total=gzMap.width*gzMap.height;
    const CHUNK=2000;
    const yieldFrame=()=>new Promise(resolve=>requestAnimationFrame(()=>setTimeout(resolve,0)));
    for(let i=0;i<total;i++){
      const x=i%gzMap.width,worldY=Math.floor(i/gzMap.width),screenY=gzMap.height-1-worldY;
      gzDrawFloor(x*GZ_TILE,screenY*GZ_TILE,gzMap.floorIds[i],gzMap.overlayIds[i]);
      if(i%CHUNK===CHUNK-1){
        status.textContent='Boden wird gezeichnet… '+Math.round((i/total)*100)+' %';
        await yieldFrame();
      }
    }
    for(let i=0;i<total;i++){
      const x=i%gzMap.width,worldY=Math.floor(i/gzMap.width),screenY=gzMap.height-1-worldY;
      gzDrawBlock(x*GZ_TILE,screenY*GZ_TILE,gzMap.blockIds[i]);
      if(i%CHUNK===CHUNK-1){
        status.textContent='Gebäude werden gezeichnet… '+Math.round((i/total)*100)+' %';
        await yieldFrame();
      }
    }
    gzSetRenderContext(activeContext);
    gzRaster=nativeCanvas;
    if(gzCoreSpawn){gzPlayerX=gzCoreSpawn.x+3;gzPlayerY=gzCoreSpawn.y+2;}else{gzPlayerX=gzMap.width/2;gzPlayerY=gzMap.height/2;}
    gzPlayerX=gzClamp(gzPlayerX,.5,gzMap.width-.5);gzPlayerY=gzClamp(gzPlayerY,.5,gzMap.height-.5);
    gzPlayerVX=0;gzPlayerVY=0;gzPlayerAngle=0;
    gzCameraX=gzPlayerX;gzCameraY=gzPlayerY;
    gzPlayerReady=true;
    gzNeedsRender=true;
    gzResize();
    status.textContent='Original-Kacheln geladen · Save v'+gzMap.version;
  }catch(err){
    gzMap=null;gzRaster=null;gzLoadFailed=true;
    status.textContent='Karte konnte nicht geladen werden';
    error.textContent='Ground Zero konnte nicht aus der eingebetteten Originaldatei gelesen werden. '+(err&&err.message?err.message:String(err));
    error.hidden=false;
  }finally{gzLoading=false;}
}
window.addEventListener('keydown',function(event){
  if(!document.getElementById('scr-groundzero').classList.contains('show'))return;
  const key=event.key.toLowerCase();
  if(['w','a','s','d','arrowup','arrowdown','arrowleft','arrowright'].includes(key)){
    event.preventDefault();
    if(!event.repeat&&['arrowup','arrowright'].includes(key))gzTargetZoom=gzClamp(gzTargetZoom*1.22,.35,10);
    if(!event.repeat&&['arrowdown','arrowleft'].includes(key))gzTargetZoom=gzClamp(gzTargetZoom/1.22,.35,10);
    gzKeys.add(key);
  }
  if(key==='escape'){event.preventDefault();closeGroundZeroGame();}
});
window.addEventListener('keyup',function(event){gzKeys.delete(event.key.toLowerCase());});
window.addEventListener('blur',function(){gzKeys.clear();});
window.addEventListener('resize',function(){if(document.getElementById('scr-groundzero').classList.contains('show'))gzResize();},{passive:true});
</script>

