function normalizeVector(point){
  const magnitude=Math.hypot(point.x,point.y,point.z)||1;
  return {x:point.x/magnitude,y:point.y/magnitude,z:point.z/magnitude};
}
function surfacePoint(latitude,longitude){
  const lat=degrees(latitude);
  const lon=degrees(longitude);
  return {x:Math.cos(lat)*Math.sin(lon),y:Math.sin(lat),z:Math.cos(lat)*Math.cos(lon)};
}
function tangentPoint(center,latitude,longitude,radius,angle){
  const lat=degrees(latitude);
  const lon=degrees(longitude);
  const east={x:Math.cos(lon),y:0,z:-Math.sin(lon)};
  const north={x:-Math.sin(lat)*Math.sin(lon),y:Math.cos(lat),z:-Math.sin(lat)*Math.cos(lon)};
  const tangent={x:east.x*Math.cos(angle)+north.x*Math.sin(angle),y:east.y*Math.cos(angle)+north.y*Math.sin(angle),z:east.z*Math.cos(angle)+north.z*Math.sin(angle)};
  return normalizeVector({x:center.x*Math.cos(radius)+tangent.x*Math.sin(radius),y:center.y*Math.cos(radius)+tangent.y*Math.sin(radius),z:center.z*Math.cos(radius)+tangent.z*Math.sin(radius)});
}
function rotatePoint(point){
  if(cachedYaw!==yaw||cachedPitch!==pitch){
    cachedYaw=yaw;
    cachedPitch=pitch;
    rotationCache={cy:Math.cos(yaw),sy:Math.sin(yaw),cp:Math.cos(pitch),sp:Math.sin(pitch)};
  }
  const {cy,sy,cp,sp}=rotationCache;
  const x=point.x*cy+point.z*sy;
  const z=-point.x*sy+point.z*cy;
  const y2=point.y*cp-z*sp;
  const z2=point.y*sp+z*cp;
  return {x,y:y2,z:z2};
}
function projectPoint(point){
  const rotated=rotatePoint(point);
  return {x:planet.x+rotated.x*planet.r,y:planet.y-rotated.y*planet.r,depth:rotated.z};
}
