.gz-build-hint.show{display:block}
.gz-buildpanel{position:absolute;z-index:5;bottom:80px;right:14px;display:none;background:rgba(12,13,16,.97);border:1px solid rgba(255,255,255,.14);border-radius:8px;backdrop-filter:blur(10px);box-shadow:0 20px 50px rgba(0,0,0,.55);max-width:calc(100vw - 28px)}
.gz-buildpanel.show{display:flex}
.gz-bp-main{display:flex;flex-direction:column;width:190px;border-right:1px solid rgba(255,255,255,.1)}
