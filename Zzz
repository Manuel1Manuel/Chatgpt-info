function chooseSectorAt(x,y){
  for(let i=renderedSectors.length-1;i>=0;i--){
    const item=renderedSectors[i];
    if(item.depth<-.025)continue;
    if(item.sector.key&&(item.sector.state==='capturable'||item.sector.state==='captured')&&pointInPolygon({x,y},item.polygon)){
      selectSector(item.sector.name,item.sector.state,item.sector.key);
      return;
    }
  }
}
sectorCanvas.addEventListener('pointerdown',event=>{
  if(!document.getElementById('scr-sectors').classList.contains('show'))return;
  pointerState={id:event.pointerId,x:event.clientX,y:event.clientY,lastX:event.clientX,lastY:event.clientY,moved:false,yaw,pitch};
  sectorCanvas.setPointerCapture(event.pointerId);
  event.preventDefault();
});
sectorCanvas.addEventListener('pointermove',event=>{
  if(!pointerState||event.pointerId!==pointerState.id)return;
  const dx=event.clientX-pointerState.x;
  const dy=event.clientY-pointerState.y;
  if(Math.abs(dx)+Math.abs(dy)>5)pointerState.moved=true;
  if(pointerState.moved){
    yaw=pointerState.yaw+dx*.006;
    pitch=Math.max(-1.05,Math.min(1.05,pointerState.pitch+dy*.004));
    pointerState.lastX=event.clientX;
    pointerState.lastY=event.clientY;
  }
  event.preventDefault();
});
function finishPointer(event){
  if(!pointerState||event.pointerId!==pointerState.id)return;
  const state=pointerState;
  pointerState=null;
  if(!state.moved)chooseSectorAt(event.clientX,event.clientY);
}
sectorCanvas.addEventListener('pointerup',finishPointer);
sectorCanvas.addEventListener('pointercancel',()=>{pointerState=null;});
