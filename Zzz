  const matching=sectors.find(sector=>sector.key===key||sector.name===name);
  if(!matching||matching.state==='locked'||matching.state==='neutral')return;
  selectedSectorName=matching.name;
  selectedSectorState=matching.state;
  selectedSectorKey=matching.key;
  document.getElementById('sector-index').textContent='#'+String(matching.sectorId).padStart(3,'0');
  document.getElementById('sector-count').textContent='#'+String(matching.sectorId).padStart(3,'0');
  document.getElementById('sel-name').textContent=sectorDisplayNames[matching.key]||matching.name;
  renderSectorResources(matching);
  const status=document.getElementById('sel-status');
  const threat=document.getElementById('sel-threat');
  const statsButton=document.getElementById('sector-info');
  const action=document.getElementById('sel-action');
  const actionIcon=document.getElementById('action-icon');
  const actionLabel=document.getElementById('action-label');
  status.className='sector-status';
  if(matching.state==='capturable'){
    status.textContent=matching.key==='ground-zero'?'Startsektor – bereit zur Landung.':'Freigeschaltet – bereit zur Landung.';
    status.classList.add('capturable');
    threat.textContent='Gefahr: '+(sectorThreats[matching.key]||'Unbekannt');
    threat.hidden=false;
    statsButton.hidden=true;
    actionLabel.textContent='Start';
    actionIcon.textContent='▶';
    action.style.display='inline-flex';
    action.disabled=false;
  }else{
    status.textContent='Erobert – Sektor gesichert.';
    threat.hidden=true;
    statsButton.hidden=false;
    actionLabel.textContent='Hingehen';
    actionIcon.textContent='▶';
    action.style.display='inline-flex';
    action.disabled=false;
  }
  drawScene(performance.now());
}
function launchSelectedSector(){
  const sector=sectors.find(item=>item.key===selectedSectorKey);
  if(!sector||sector.state==='locked'||sector.state==='neutral')return;
  if(sector.state==='captured'){
    toast('Der Sektorwechsel ist in dieser visuellen Demo noch nicht verbunden.');
    return;
  }
  completedSectorKeys.add(sector.key);
  saveCampaignProgress();
  refreshCampaignStates();
  refreshResearchSectorLocks();
  selectSector(sector.name,sector.state,sector.key);
  const newlyUnlocked=sectors.filter(item=>item.state==='capturable'&&!completedSectorKeys.has(item.key));
  toast(newlyUnlocked.length?'Demo-Abschluss simuliert. Neue Kampagnensektoren wurden freigeschaltet.':'Demo-Abschluss simuliert.');
}

