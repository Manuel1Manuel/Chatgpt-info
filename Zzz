  ctx.save();
  ctx.translate(planet.x,planet.y);
  ctx.rotate(.43);
  ctx.strokeStyle='rgba(178,135,255,.28)';
  ctx.lineWidth=1.3;
  ctx.beginPath();
  ctx.ellipse(0,0,r*1.22,r*1.04,0,degrees(196),degrees(345));
