.gz-resource{position:absolute;z-index:4;top:54px;left:max(12px,env(safe-area-inset-left));display:flex;align-items:center;gap:6px;padding:5px 11px;background:rgba(8,10,15,.82);border:1px solid rgba(255,255,255,.14);border-radius:20px;font-size:12.5px;font-weight:600;color:#f2c14e;box-shadow:0 6px 16px rgba(0,0,0,.3)}
