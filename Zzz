.gz-bp-item:hover{border-color:rgba(255,255,255,.3)}
.gz-bp-item.active{border-color:#f2c14e;box-shadow:0 0 0 1px #f2c14e inset}
.gz-bp-cost{position:absolute;right:1px;bottom:1px;font-size:8.5px;line-height:1;background:rgba(0,0,0,.72);color:#f2c14e;padding:1.5px 3px;border-radius:3px;font-weight:700}
