function drawPlanetBase(){
  const ctx=sectorContext;
  const r=planet.r;
  ctx.save();
  ctx.shadowColor='rgba(0,0,0,.8)';
  ctx.shadowBlur=r*.22;
  ctx.shadowOffsetY=r*.1;
  const base=ctx.createRadialGradient(planet.x-r*.35,planet.y-r*.42,r*.03,planet.x+r*.08,planet.y+r*.15,r*1.13);
  base.addColorStop(0,'#514365');
  base.addColorStop(.29,'#3b304c');
  base.addColorStop(.6,'#211c30');
  base.addColorStop(.82,'#100d1a');
  base.addColorStop(1,'#06050b');
  ctx.fillStyle=base;
  ctx.beginPath();
  ctx.arc(planet.x,planet.y,r,0,Math.PI*2);
  ctx.fill();
  ctx.restore();
  ctx.save();
  ctx.beginPath();
  ctx.arc(planet.x,planet.y,r,0,Math.PI*2);
  ctx.clip();
  drawTerrainFacets();
  const shade=ctx.createRadialGradient(planet.x-r*.35,planet.y-r*.42,r*.02,planet.x+r*.18,planet.y+r*.16,r*1.15);
  shade.addColorStop(0,'rgba(213,174,255,.13)');
  shade.addColorStop(.42,'rgba(69,48,93,.03)');
  shade.addColorStop(.72,'rgba(6,5,12,.16)');
  shade.addColorStop(1,'rgba(0,0,0,.88)');
  ctx.fillStyle=shade;
  ctx.fillRect(planet.x-r,planet.y-r,r*2,r*2);
  ctx.restore();
  ctx.save();
  const rim=ctx.createRadialGradient(planet.x-r*.35,planet.y-r*.35,r*.45,planet.x,planet.y,r*1.02);
  rim.addColorStop(.76,'rgba(255,255,255,0)');
  rim.addColorStop(.91,'rgba(168,122,255,.17)');
  rim.addColorStop(.97,'rgba(160,98,255,.5)');
  rim.addColorStop(1,'rgba(104,64,203,.13)');
  ctx.fillStyle=rim;
  ctx.beginPath();
  ctx.arc(planet.x,planet.y,r,0,Math.PI*2);
  ctx.fill();
  ctx.strokeStyle='rgba(217,193,255,.32)';
  ctx.lineWidth=1;
  ctx.beginPath();
  ctx.arc(planet.x,planet.y,r-.5,0,Math.PI*2);
  ctx.stroke();
  ctx.restore();
}
function drawTerrainFacets(){
  const ctx=sectorContext;
  for(const facet of facets){
    const center=projectPoint(facet.point);
    if(center.depth<-.02)continue;
    const lit=Math.max(0,facet.point.x*-.42+facet.point.y*.5+facet.point.z*.76);
    const alpha=facet.alpha*(.16+lit*.84)*Math.min(1,Math.max(.16,center.depth*2.2));
    ctx.globalAlpha=alpha;
    ctx.fillStyle=terrainPalette[facet.shade];
    ctx.beginPath();
    facet.vertices.forEach((vertex,index)=>{
      const projected=projectPoint(vertex);
      if(index===0)ctx.moveTo(projected.x,projected.y);else ctx.lineTo(projected.x,projected.y);
    });
    ctx.closePath();
    ctx.fill();
  }
  ctx.globalAlpha=1;
}
function pointInPolygon(point,polygon){
  let inside=false;
  for(let i=0,j=polygon.length-1;i<polygon.length;j=i){
    const a=polygon[i];
    const b=polygon[j];
    const intersects=((a.y>point.y)!==(b.y>point.y))&&(point.x<(b.x-a.x)*(point.y-a.y)/(b.y-a.y+Number.EPSILON)+a.x);
    if(intersects)inside=!inside;
  }
  return inside;
}
function sectorCorners(sector){
  return sector.corners;
}
function drawSectorIcon(x,y,scale,type,color,alpha){
  const ctx=sectorContext;
  const size=scale;
  ctx.save();
  ctx.globalAlpha=alpha;
  ctx.strokeStyle=color;
  ctx.fillStyle=color;
  ctx.lineWidth=Math.max(.8,size*.14);
  ctx.lineJoin='round';
  ctx.lineCap='round';
  if(type===0){
    ctx.beginPath();
    ctx.rect(x-size*.55,y-size*.4,size*1.1,size*.8);
    ctx.stroke();
    ctx.beginPath();
    ctx.arc(x,y,size*.16,0,Math.PI*2);
    ctx.fill();
  }else if(type===1){
    ctx.beginPath();
    ctx.moveTo(x,y-size*.65);
    ctx.lineTo(x+size*.56,y);
    ctx.lineTo(x,y+size*.65);
    ctx.lineTo(x-size*.56,y);
    ctx.closePath();
    ctx.stroke();
  }else if(type===2){
    ctx.beginPath();
    ctx.arc(x,y,size*.45,0,Math.PI*2);
    ctx.stroke();
    ctx.beginPath();
    ctx.arc(x,y,size*.13,0,Math.PI*2);
    ctx.fill();
  }else if(type===3){
    ctx.beginPath();
    ctx.moveTo(x-size*.55,y-size*.35);
    ctx.lineTo(x+size*.55,y-size*.35);
    ctx.lineTo(x+size*.32,y+size*.4);
    ctx.lineTo(x-size*.32,y+size*.4);
    ctx.closePath();
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(x,y-size*.25);
    ctx.lineTo(x,y+size*.3);
    ctx.stroke();
  }else{
    ctx.beginPath();
    ctx.moveTo(x-size*.55,y);
    ctx.lineTo(x,y-size*.55);
    ctx.lineTo(x+size*.55,y);
    ctx.lineTo(x,y+size*.55);
    ctx.closePath();
    ctx.stroke();
    ctx.beginPath();
    ctx.arc(x,y,size*.13,0,Math.PI*2);
    ctx.fill();
  }
  ctx.restore();
}
function drawSectors(){
  const ctx=sectorContext;
  renderedSectors=[];
  const visible=[];
  for(const sector of sectors){
    const center=projectPoint(sector.point);
    if(center.depth<-.085)continue;
    const corners=sectorCorners(sector).map(projectPoint);
    visible.push({sector,center,corners});
  }
  visible.sort((a,b)=>a.center.depth-b.center.depth);
  ctx.save();
  ctx.beginPath();
  ctx.arc(planet.x,planet.y,planet.r-.2,0,Math.PI*2);
  ctx.clip();
  for(const item of visible){
    const {sector,center,corners}=item;
    const selected=sector.key===selectedSectorKey;
    const available=sector.state==='capturable';
    const captured=sector.state==='captured';
    const shown=available||captured||selected&&sector.state!=='locked';
    const depthOpacity=Math.min(1,Math.max(.16,.24+(center.depth+.08)*.9));
    ctx.globalAlpha=depthOpacity;
    ctx.beginPath();
    corners.forEach((corner,index)=>{
      if(index===0)ctx.moveTo(corner.x,corner.y);else ctx.lineTo(corner.x,corner.y);
    });
    ctx.closePath();
    if(!shown){
      ctx.fillStyle='rgba(5,4,12,.43)';
      ctx.fill();
      continue;
    }
    let fill='rgba(111,100,147,.045)';
    let stroke='rgba(209,199,243,.62)';
    let lineWidth=.95;
    let tint='#e8dfff';
    if(captured){
      fill='rgba(255,187,103,.075)';
      stroke='rgba(255,201,127,.88)';
      tint='#ffdba4';
    }else if(available){
      fill='rgba(145,113,216,.12)';
      stroke='rgba(207,184,255,.92)';
      tint='#ddc8ff';
    }
    if(selected){
      fill=captured?'rgba(255,184,91,.34)':'rgba(255,184,91,.42)';
      stroke='#ffe8b4';
      lineWidth=2.2;
      tint='#fff0ca';
    }else{
      lineWidth=sector.key?1.35:.95;
    }
    ctx.fillStyle=fill;
    ctx.fill();
    ctx.lineWidth=lineWidth;
    ctx.strokeStyle=stroke;
    if(selected){
      ctx.shadowColor='rgba(255,174,89,.96)';
      ctx.shadowBlur=17;
    }else if(captured||available){
      ctx.shadowColor=stroke;
      ctx.shadowBlur=3.5;
    }else{
      ctx.shadowBlur=0;
    }
    ctx.stroke();
    ctx.shadowBlur=0;
    if(sector.key&&center.depth>.02){
      const scale=5.4+Math.max(0,center.depth)*1.8;
      drawSectorIcon(center.x,center.y,scale,sector.iconType,tint,Math.min(1,depthOpacity*.98));
    }
    if(selected){
      ctx.globalAlpha=1;
      ctx.strokeStyle='rgba(255,244,216,.92)';
      ctx.lineWidth=1;
      ctx.beginPath();
      ctx.arc(center.x,center.y,3,0,Math.PI*2);
      ctx.stroke();
    }
    renderedSectors.push({sector,center,polygon:corners.map(point=>({x:point.x,y:point.y})),depth:center.depth});
  }
  ctx.restore();
  ctx.globalAlpha=1;
}
function drawScene(time){
  if(!sectorContext)return;
  const ctx=sectorContext;
  ctx.clearRect(0,0,viewportWidth,viewportHeight);
  drawStars(time);
  drawOrbit();
  drawAtmosphere();
  drawPlanetBase();
  drawSectors();
  const vignette=ctx.createRadialGradient(viewportWidth/2,viewportHeight*.42,Math.min(viewportWidth,viewportHeight)*.2,viewportWidth/2,viewportHeight*.42,Math.max(viewportWidth,viewportHeight)*.78);
  vignette.addColorStop(0,'rgba(0,0,0,0)');
  vignette.addColorStop(1,'rgba(0,0,0,.22)');
  ctx.fillStyle=vignette;
  ctx.fillRect(0,0,viewportWidth,viewportHeight);
}
function animate(time){
  if(document.getElementById('scr-sectors').classList.contains('show')&&time-lastDrawTime>32){
    drawScene(time);
    lastDrawTime=time;
  }
  animationFrame=requestAnimationFrame(animate);
}
function chooseSectorAt(x,y){
  for(let i=renderedSectors.length-1;i>=0;i--){
    const item=renderedSectors[i];
    if(item.depth<-.025)continue;
    if(item.sector.key&&(item.sector.state==='capturable'||item.sector.state==='captured')&&pointInPolygon({x,y},item.polygon)){
      selectSector(item.sector.name,item.sector.state,item.sector.key);
      return;
    }
  }
}
sectorCanvas.addEventListener('pointerdown',event=>{
  if(!document.getElementById('scr-sectors').classList.contains('show'))return;
  pointerState={id:event.pointerId,x:event.clientX,y:event.clientY,lastX:event.clientX,lastY:event.clientY,moved:false,yaw,pitch};
  sectorCanvas.setPointerCapture(event.pointerId);
  event.preventDefault();
});
sectorCanvas.addEventListener('pointermove',event=>{
  if(!pointerState||event.pointerId!==pointerState.id)return;
  const dx=event.clientX-pointerState.x;
  const dy=event.clientY-pointerState.y;
  if(Math.abs(dx)+Math.abs(dy)>5)pointerState.moved=true;
  if(pointerState.moved){
    yaw=pointerState.yaw+dx*.006;
    pitch=Math.max(-1.05,Math.min(1.05,pointerState.pitch+dy*.004));
    pointerState.lastX=event.clientX;
    pointerState.lastY=event.clientY;
  }
  event.preventDefault();
});
function finishPointer(event){
  if(!pointerState||event.pointerId!==pointerState.id)return;
  const state=pointerState;
  pointerState=null;
  if(!state.moved)chooseSectorAt(event.clientX,event.clientY);
}
sectorCanvas.addEventListener('pointerup',finishPointer);
sectorCanvas.addEventListener('pointercancel',()=>{pointerState=null;});
window.addEventListener('resize',resizeCanvas,{passive:true});
