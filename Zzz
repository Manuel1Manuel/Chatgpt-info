  if(gzCopper<def.cost){toast('Nicht genug Kupfer für '+def.name);return;}
  const tx=Math.round(tileX),ty=Math.round(tileY);
  if(tx<1||ty<1||tx>gzMap.width-1||ty>gzMap.height-1){toast('Außerhalb der Karte');return;}
  if(gzPlacedBlocks.some(b=>Math.abs(b.x-tx)<1&&Math.abs(b.y-ty)<1)){toast('Dort steht schon etwas');return;}
  if(gzCoreSpawn&&Math.hypot(tx-gzCoreSpawn.x,ty-gzCoreSpawn.y)<2.3){toast('Zu nah am Core');return;}
  gzCopper-=def.cost;
  gzPlacedBlocks.push({x:tx,y:ty,cat:gzBuildMode.cat,idx:gzBuildMode.idx});
  gzUpdateCopperUI();
  toast(def.name+' gebaut');
}
