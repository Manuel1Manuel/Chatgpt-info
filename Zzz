    return {label:'SEKTOR ERFORDERLICH',className:'gated',detail:'Zuerst Sektor abschließen: '+(sector?sector.name:node.sector)+'.'};
  }
  const missingParents=node.parents.map(id=>researchNodes.find(item=>item.id===id)).filter(parent=>parent&&!parent.root);
  if(missingParents.length){
    return {label:'VORAUSSETZUNG FEHLT',className:'gated',detail:'Zuerst erforschen: '+missingParents.map(parent=>parent.name).join(', ')+'.'};
  }
  return {label:'BEREIT ZUR ERFORSCHUNG',className:'ready',detail:'Die direkten Voraussetzungen sind erfüllt. Für die Forschung werden Ressourcen aus dem Kerninventar benötigt.'};
}
function researchNodeIcon(node){return `<span class="research-glyph ${node.color||''}">${node.glyph}</span>`;}
function renderResearchNodes(){
  const canvas=document.getElementById('research-canvas');
  canvas.querySelectorAll('.research-node').forEach(element=>element.remove());
  const lines=document.getElementById('research-connections');
  lines.innerHTML='';
  const nodeMap=new Map(researchNodes.map(node=>[node.id,node]));
  for(const node of researchNodes){
    for(const parentId of node.parents){
      const parent=nodeMap.get(parentId);
      if(!parent)continue;
      const line=document.createElementNS('http://www.w3.org/2000/svg','path');
      const x1=parent.x+158,y1=parent.y+39,x2=node.x,y2=node.y+39,mid=(x1+x2)/2;
      line.setAttribute('d',`M${x1} ${y1} C${mid} ${y1},${mid} ${y2},${x2} ${y2}`);
      const gated=node.sector&&!completedSectorKeys.has(node.sector);
      line.setAttribute('class','research-link'+(!gated&&parent.root?' available':''));
      line.dataset.child=node.id;line.dataset.parent=parentId;
      lines.appendChild(line);
    }
  }
  for(const node of researchNodes){
    const status=researchNodeStatus(node);
    const button=document.createElement('button');
    button.type='button';button.className='research-node '+(node.root?'researched':status.className==='gated'?'sector-gated locked':'available')+(node.id===selectedResearchId?' selected':'');
    button.dataset.id=node.id;button.dataset.category=node.category;button.style.left=node.x+'px';button.style.top=node.y+'px';
    button.innerHTML=`${researchNodeIcon(node)}<span class="research-node-copy"><strong>${node.name}</strong><small>${node.short}</small><span class="research-node-cost">${node.root?'Starttechnologie':node.cost.map(item=>`${item[1].toLocaleString('de-DE')} ${item[0]}`).join(' · ')}</span></span>`;
    button.addEventListener('click',()=>selectResearch(node.id));
    canvas.appendChild(button);
  }
  applyResearchFilters();
}
function renderResearchDetail(){
  const node=researchNodes.find(item=>item.id===selectedResearchId)||researchNodes[0];
  const status=researchNodeStatus(node);
  const panel=document.getElementById('research-detail');
  const costMarkup=node.cost.length?node.cost.map(item=>`<div class="research-cost-item"><span class="research-item-icon" style="--item-color:${item[2]}"></span><span>${item[0]}</span><strong class="research-cost-amount">${item[1].toLocaleString('de-DE')}</strong></div>`).join(''):'<div class="research-prereq">✓ Keine Forschungskosten · Grundtechnologie</div>';
  const prereqs=node.parents.length?node.parents.map(parentId=>{const parent=researchNodes.find(item=>item.id===parentId);return `<div class="research-prereq"><span class="research-prereq-icon">◇</span><span>Benötigt: ${parent?parent.name:parentId}</span></div>`}).join(''):'<div class="research-prereq"><span class="research-prereq-icon">✓</span><span>Starttechnologie von Serpulo</span></div>';
  const sector=node.sector?sectorNames.find(item=>item.key===node.sector):null;
  const condition=node.sector?`<div class="research-prereq"><span class="research-prereq-icon">⌖</span><span>Sektor abschließen: ${sector?sector.name:node.sector}</span></div>`:'';
  const extra=node.extra?`<div class="research-prereq"><span class="research-prereq-icon">ⓘ</span><span>${node.extra}</span></div>`:'';
  panel.innerHTML=`<div class="research-detail-kicker">${node.category} · SERPULO</div><div class="research-detail-head">${researchNodeIcon(node)}<div><h3>${node.name}</h3><p>${node.root?'Grundtechnologie':'Forschungskosten gemäß Serpulo-Techbaum'}</p></div></div><div class="research-state ${status.className}">${status.label}</div><p class="research-description">${node.description} ${status.detail}</p><section class="research-detail-section"><h4>Forschungskosten</h4><div class="research-cost-list">${costMarkup}</div></section><section class="research-detail-section"><h4>Voraussetzungen</h4><div class="research-prereq-list">${prereqs}${condition}${extra}</div></section><div class="research-progress"><span></span></div><div class="research-progress-label">0 % abgeschlossen · Kerninventar nicht verfügbar</div><button class="research-unavailable" type="button" disabled>FORSCHUNG NOCH NICHT VERFÜGBAR</button>`;
}
function selectResearch(id){
  if(!researchNodes.some(node=>node.id===id))return;
  selectedResearchId=id;
  document.querySelectorAll('.research-node').forEach(button=>button.classList.toggle('selected',button.dataset.id===id));
  renderResearchDetail();
}
function applyResearchFilters(){
  const term=(document.getElementById('research-search')?.value||'').trim().toLocaleLowerCase('de-DE');
  document.querySelectorAll('.research-node').forEach(button=>{
    const node=researchNodes.find(item=>item.id===button.dataset.id);
    const categoryMatch=researchFilter==='Alle'||node.category===researchFilter;
    const searchMatch=!term||(node.name+' '+node.description+' '+node.short).toLocaleLowerCase('de-DE').includes(term);
    button.hidden=!(categoryMatch&&searchMatch);
  });
  const lines=document.getElementById('research-connections');
  if(lines){
    Array.from(lines.children).forEach(line=>{
      const child=document.querySelector(`.research-node[data-id="${line.dataset.child}"]`);
      const parent=document.querySelector(`.research-node[data-id="${line.dataset.parent}"]`);
      line.style.display=child&&!child.hidden&&parent&&!parent.hidden?'':'none';
    });
  }
}
function setResearchFilter(filter,button){
  researchFilter=filter;
  document.querySelectorAll('.research-filter').forEach(item=>item.classList.toggle('active',item===button));
  applyResearchFilters();
}
function searchResearch(value){applyResearchFilters();}
function openResearchTree(){
  const screen=document.getElementById('research-screen');
  screen.classList.add('show');
  screen.setAttribute('aria-hidden','false');
  renderResearchNodes();
  renderResearchDetail();
  document.querySelector('.research-close').focus({preventScroll:true});
}
function closeResearchTree(){
  const screen=document.getElementById('research-screen');
  screen.classList.remove('show');
  screen.setAttribute('aria-hidden','true');
  document.getElementById('research-trigger')?.focus({preventScroll:true});
}
function refreshResearchSectorLocks(){
  if(!document.getElementById('research-screen').classList.contains('show'))return;
  renderResearchNodes();
  renderResearchDetail();
}

function openModal(id){document.getElementById('ov-'+id).classList.add('show');}
function closeModal(id){document.getElementById('ov-'+id).classList.remove('show');}
function toggleSetting(element){
  const on=element.classList.toggle('on');
  element.setAttribute('aria-checked',String(on));
}
function toggleSettingKey(event,element){
  if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleSetting(element);}
}
document.querySelectorAll('.overlay').forEach(overlay=>{
  overlay.addEventListener('click',event=>{
    if(event.target===overlay)overlay.classList.remove('show');
  });
});
window.addEventListener('keydown',event=>{
  if(event.key==='Escape'){
    if(document.getElementById('research-screen').classList.contains('show'))closeResearchTree();
    document.querySelectorAll('.overlay.show').forEach(overlay=>overlay.classList.remove('show'));
  }
  if(event.key.toLowerCase()==='t'&&!event.repeat&&!event.ctrlKey&&!event.metaKey&&!event.altKey){
    const active=document.getElementById('scr-sectors').classList.contains('show');
    const target=event.target;
    const typing=target&&(target.isContentEditable||['INPUT','TEXTAREA','SELECT'].includes(target.tagName));
    if(active&&!typing){event.preventDefault();document.getElementById('research-screen').classList.contains('show')?closeResearchTree():openResearchTree();}
  }
});
document.getElementById('research-screen').addEventListener('click',event=>{if(event.target.id==='research-screen')closeResearchTree();});
function toast(message){
  const element=document.getElementById('toast');
  element.textContent=message;
  element.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>element.classList.remove('show'),2200);
}
loadCampaignProgress();
sectors=createSectors();
refreshCampaignStates();
facets=createFacets();
aimAtSector('ground-zero');
resizeCanvas();
selectSector('Ground Zero','capturable','ground-zero');
renderResearchNodes();
renderResearchDetail();
animationFrame=requestAnimationFrame(animate);
</script>
</body>
