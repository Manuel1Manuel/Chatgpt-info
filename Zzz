  try{localStorage.setItem(campaignStorageKey,JSON.stringify({completed:[...completedSectorKeys]}));}catch(error){}
}
function refreshCampaignStates(){
  const completedIds=new Set(sectors.filter(sector=>sector.key&&completedSectorKeys.has(sector.key)).map(sector=>sector.sectorId));
  for(const sector of sectors){
    if(!sector.key){sector.state='neutral';continue;}
    if(completedSectorKeys.has(sector.key)){sector.state='captured';continue;}
    const requirements=campaignRequirements[sector.key];
    const requirementsMet=Array.isArray(requirements)&&requirements.every(key=>completedSectorKeys.has(key));
    const adjacentToCaptured=sector.neighbors.some(id=>completedIds.has(id));
    sector.state=sector.key==='ground-zero'||requirementsMet&&adjacentToCaptured?'capturable':'locked';
  }
}

