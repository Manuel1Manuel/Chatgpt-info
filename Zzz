  glow.addColorStop(.61,'rgba(148,88,255,.28)');
  glow.addColorStop(.76,'rgba(108,55,222,.24)');
  glow.addColorStop(.9,'rgba(77,41,164,.1)');
  glow.addColorStop(1,'rgba(67,37,142,0)');
  ctx.fillStyle=glow;
