}
function projectPoint(point){
  const rotated=rotatePoint(point);
  return {x:planet.x+rotated.x*planet.r,y:planet.y-rotated.y*planet.r,depth:rotated.z};
}
function aimAtSector(key){
  const target=sectors.find(sector=>sector.key===key);
  if(!target)return;
  yaw=Math.atan2(-target.point.x,target.point.z);
  pitch=Math.atan2(target.point.y,Math.hypot(target.point.x,target.point.z));
  cachedYaw=NaN;
  cachedPitch=NaN;
}
function createPlanetTile(id){
  const edgeCount=id<12?5:6;
  return {id,edgeCount,tiles:new Array(edgeCount).fill(null),corners:new Array(edgeCount).fill(null),point:null};
}
function createPlanetCorner(id){
  return {id,tiles:new Array(3).fill(null),corners:new Array(3).fill(null),point:null};
}
function planetGridPosition(tile,target){
  return tile.tiles.indexOf(target);
}
function addPlanetCorner(grid,id,t1,t2,t3){
  const corner=grid.corners[id];
  const adjacent=[grid.tiles[t1],grid.tiles[t2],grid.tiles[t3]];
  corner.point=normalizeVector({
    x:adjacent[0].point.x+adjacent[1].point.x+adjacent[2].point.x,
    y:adjacent[0].point.y+adjacent[1].point.y+adjacent[2].point.y,
    z:adjacent[0].point.z+adjacent[1].point.z+adjacent[2].point.z
  });
  for(let i=0;i<3;i++){
    const tile=adjacent[i];
    const neighbor=adjacent[(i+2)%3];
    tile.corners[planetGridPosition(tile,neighbor)]=corner;
    corner.tiles[i]=tile;
  }
}
function connectPlanetCorners(grid){
  for(const corner of grid.corners){
    for(let i=0;i<3;i++){
      const tile=corner.tiles[i];
      const position=tile.corners.indexOf(corner);
      corner.corners[i]=tile.corners[(position+1)%tile.edgeCount];
    }
  }
}
function createInitialPlanetGrid(){
  const x=-0.525731112119133606;
  const z=-0.850650808352039932;
  const points=[
    {x:-x,y:0,z},{x:x,y:0,z},{x:-x,y:0,z:-z},{x,y:0,z:-z},
    {x:0,y:z,z:x},{x:0,y:z,z:-x},{x:0,y:-z,z:x},{x:0,y:-z,z:-x},
    {x:z,y:x,z:0},{x:-z,y:x,z:0},{x:z,y:-x,z:0},{x:-z,y:-x,z:0}
  ];
  const neighbors=[
    [9,4,1,6,11],[4,8,10,6,0],[11,7,3,5,9],[2,7,10,8,5],
    [9,5,8,1,0],[2,3,8,4,9],[0,1,10,7,11],[11,6,10,3,2],
    [5,3,10,1,4],[2,5,4,0,11],[3,7,6,1,8],[7,2,9,0,6]
  ];
  const grid={size:0,tiles:Array.from({length:12},(_,id)=>createPlanetTile(id)),corners:Array.from({length:20},(_,id)=>createPlanetCorner(id))};
  grid.tiles.forEach((tile,index)=>{
    tile.point=points[index];
    tile.tiles=neighbors[index].map(id=>grid.tiles[id]);
  });
  for(let i=0;i<5;i++)addPlanetCorner(grid,i,0,neighbors[0][(i+4)%5],neighbors[0][i]);
  for(let i=0;i<5;i++)addPlanetCorner(grid,i+5,3,neighbors[3][(i+4)%5],neighbors[3][i]);
  addPlanetCorner(grid,10,10,1,8);
  addPlanetCorner(grid,11,1,10,6);
  addPlanetCorner(grid,12,6,10,7);
  addPlanetCorner(grid,13,6,7,11);
  addPlanetCorner(grid,14,11,7,2);
  addPlanetCorner(grid,15,11,2,9);
  addPlanetCorner(grid,16,9,2,5);
  addPlanetCorner(grid,17,9,5,4);
  addPlanetCorner(grid,18,4,5,8);
  addPlanetCorner(grid,19,4,8,1);
  connectPlanetCorners(grid);
  return grid;
}
function subdividePlanetGrid(previous){
  const previousTileCount=previous.tiles.length;
  const previousCornerCount=previous.corners.length;
  const size=previous.size+1;
  const grid={
    size,
    tiles:Array.from({length:10*Math.pow(3,size)+2},(_,id)=>createPlanetTile(id)),
    corners:Array.from({length:20*Math.pow(3,size)},(_,id)=>createPlanetCorner(id))
  };
  for(let i=0;i<previousTileCount;i++){
    const tile=grid.tiles[i];
    tile.point=previous.tiles[i].point;
    for(let k=0;k<tile.edgeCount;k++)tile.tiles[k]=grid.tiles[previous.tiles[i].corners[k].id+previousTileCount];
  }
  for(let i=0;i<previousCornerCount;i++){
    const previousCorner=previous.corners[i];
    const tile=grid.tiles[i+previousTileCount];
    tile.point=previousCorner.point;
    for(let k=0;k<3;k++){
      tile.tiles[2*k]=grid.tiles[previousCorner.corners[k].id+previousTileCount];
      tile.tiles[2*k+1]=grid.tiles[previousCorner.tiles[k].id];
    }
  }
  let nextCorner=0;
  for(const previousTile of previous.tiles){
    const tile=grid.tiles[previousTile.id];
    for(let k=0;k<tile.edgeCount;k++){
      addPlanetCorner(grid,nextCorner++,tile.id,tile.tiles[(k+tile.edgeCount-1)%tile.edgeCount].id,tile.tiles[k].id);
    }
  }
  connectPlanetCorners(grid);
  return grid;
}
function createOfficialPlanetGrid(size){
  let grid=createInitialPlanetGrid();
  for(let i=0;i<size;i++)grid=subdividePlanetGrid(grid);
  return grid;
}
function createSectors(){
  const grid=createOfficialPlanetGrid(3);
  const presets=new Map(sectorNames.map(item=>[item.id,item]));
  return grid.tiles.map(tile=>{
    const preset=presets.get(tile.id);
    const markerRoll=random();
    return {
      id:'sector-'+tile.id,
      sectorId:tile.id,
      point:tile.point,
      neighbors:tile.tiles.map(neighbor=>neighbor.id),
      corners:tile.corners.map(corner=>corner.point),
      key:preset?.key||null,
      name:preset?.name||null,
      state:'locked',
      iconType:preset?4:markerRoll>.47?Math.floor(random()*5):-1,
      visualTint:random(),
      hexRotation:0
    };
  });
}
function createFacets(){
  const result=[];
  const count=560;
  const goldenAngle=Math.PI*(3-Math.sqrt(5));
  for(let index=0;index<count;index++){
    const y=1-(index/(count-1))*2;
    const ring=Math.sqrt(Math.max(0,1-y*y));
    const angle=goldenAngle*index;
    const point={x:Math.cos(angle)*ring,y,z:Math.sin(angle)*ring};
    const radius=degrees(2.2+random()*2.7);
    const sides=5+Math.floor(random()*3);
    const rotation=random()*Math.PI*2;
    const latitude=Math.asin(point.y)*180/Math.PI;
    const longitude=Math.atan2(point.x,point.z)*180/Math.PI;
    const vertices=[];
    for(let side=0;side<sides;side++)vertices.push(tangentPoint(point,latitude,longitude,radius,rotation+Math.PI*2*side/sides));
    result.push({
      point,
      vertices,
      shade:Math.floor(random()*terrainPalette.length),
      alpha:.27+random()*.48
    });
  }
  return result;
}
function createStars(){
  const result=[];
  const count=Math.min(230,Math.max(105,Math.round(viewportWidth*viewportHeight/5200)));
  for(let i=0;i<count;i++){
    result.push({x:random()*viewportWidth,y:random()*viewportHeight,r:.35+random()*1.15,alpha:.18+random()*.64,phase:random()*Math.PI*2});
  }
  return result;
}
function resizeCanvas(){
  viewportWidth=window.innerWidth;
  viewportHeight=window.innerHeight;
  pixelRatio=Math.min(window.devicePixelRatio||1,2);
  sectorCanvas.width=Math.round(viewportWidth*pixelRatio);
  sectorCanvas.height=Math.round(viewportHeight*pixelRatio);
  sectorCanvas.style.width=viewportWidth+'px';
  sectorCanvas.style.height=viewportHeight+'px';
  sectorContext.setTransform(pixelRatio,0,0,pixelRatio,0,0);
  const radius=Math.min(viewportWidth*.39,viewportHeight*.305,310);
  planet={x:viewportWidth/2,y:Math.max(radius+48,Math.min(viewportHeight*.455,viewportHeight-radius-158)),r:radius};
  stars=createStars();
  drawScene(performance.now());
}
function drawStars(time){
  const ctx=sectorContext;
  for(const star of stars){
    const shimmer=.78+.22*Math.sin(time*.00055+star.phase);
    ctx.globalAlpha=star.alpha*shimmer;
    ctx.fillStyle=star.r>1?'#d9d0ff':'#fff';
    ctx.beginPath();
    ctx.arc(star.x,star.y,star.r,0,Math.PI*2);
    ctx.fill();
  }
  ctx.globalAlpha=1;
}
function drawOrbit(){
  const ctx=sectorContext;
  ctx.save();
  ctx.translate(planet.x,planet.y);
  ctx.rotate(-.25);
  ctx.strokeStyle='rgba(143,111,219,.16)';
  ctx.lineWidth=1;
  ctx.beginPath();
  ctx.ellipse(0,0,planet.r*1.52,planet.r*.39,0,0,Math.PI*2);
  ctx.stroke();
  ctx.strokeStyle='rgba(109,79,184,.1)';
  ctx.beginPath();
  ctx.ellipse(0,0,planet.r*1.67,planet.r*.48,0,0,Math.PI*2);
  ctx.stroke();
  ctx.restore();
}
function drawAtmosphere(){
  const ctx=sectorContext;
  const r=planet.r;
  const glow=ctx.createRadialGradient(planet.x,planet.y,r*.73,planet.x,planet.y,r*1.38);
