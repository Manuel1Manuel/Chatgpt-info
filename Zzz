.gz-topbar,.gz-bottombar{position:absolute;z-index:3;display:flex;align-items:center;gap:12px;background:rgba(8,10,15,.83);border:1px solid rgba(255,255,255,.13);box-shadow:0 8px 28px rgba(0,0,0,.35);backdrop-filter:blur(8px);color:#eceef2}
.gz-topbar{left:max(12px,env(safe-area-inset-left));right:max(12px,env(safe-area-inset-right));top:max(12px,env(safe-area-inset-top));min-height:46px;padding:7px 12px;justify-content:space-between}
