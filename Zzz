<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#070611">
<title>Mindustry – Serpulo</title>
<style>
:root{
  --bg:#2c2c34;
  --bg2:#35353f;
  --ore-purple:#7e6bb5;
  --ore-purple2:#9c89cf;
  --ore-orange:#e2884f;
  --text:#eef0f2;
  --muted:#9a9aa8;
  --accent:#f2c14e;
  --accent2:#e2884f;
  --panel:rgba(14,14,18,.55);
  --panel-strong:rgba(10,10,14,.88);
  --btn-hover:rgba(255,255,255,.08);
  --btn-active:rgba(255,255,255,.16);
  --border:rgba(255,255,255,.08);
  color-scheme:dark;
}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{
  font-family:"Segoe UI",system-ui,Arial,sans-serif;
  color:var(--text);
  overflow:hidden;
  background-color:var(--bg);
  background-image:
    radial-gradient(ellipse 520px 420px at 88% 14%,rgba(226,136,79,.28),transparent 60%),
    radial-gradient(ellipse 620px 520px at 92% 32%,rgba(126,107,181,.4),transparent 65%),
    radial-gradient(ellipse 760px 620px at 58% 96%,rgba(126,107,181,.32),transparent 60%),
    radial-gradient(ellipse 420px 380px at 4% 92%,rgba(126,107,181,.22),transparent 60%),
    repeating-linear-gradient(45deg,rgba(255,255,255,.03) 0 3px,transparent 3px 11px),
    linear-gradient(135deg,var(--bg),var(--bg2));
}
body::before{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:0;
  background-image:
    repeating-linear-gradient(0deg,rgba(0,0,0,.18) 0 1px,transparent 1px 40px),
    repeating-linear-gradient(90deg,rgba(0,0,0,.18) 0 1px,transparent 1px 40px);
}
body::after{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:0;
  opacity:.55;
  background-image:
    radial-gradient(3px 3px at 15% 78%,var(--ore-purple),transparent 60%),
    radial-gradient(3px 3px at 20% 83%,var(--ore-purple2),transparent 60%),
    radial-gradient(2px 2px at 25% 70%,var(--ore-purple),transparent 60%),
    radial-gradient(3px 3px at 92% 10%,var(--ore-orange),transparent 60%),
    radial-gradient(2px 2px at 95% 18%,var(--ore-orange),transparent 60%),
    radial-gradient(3px 3px at 88% 24%,var(--ore-orange),transparent 60%),
    radial-gradient(2px 2px at 97% 7%,var(--ore-orange),transparent 60%);
  background-size:220px 220px;
}
button{font:inherit}
.scene{
  position:relative;
  z-index:1;
  height:100%;
  display:flex;
  flex-direction:column;
  align-items:center;
  padding:28px 20px 20px;
}
.titlewrap{display:flex;align-items:center;gap:18px;margin-top:10px}
.chevron{width:0;height:0;filter:drop-shadow(0 2px 2px rgba(0,0,0,.5))}
.chevron.left{border-top:22px solid transparent;border-bottom:22px solid transparent;border-right:28px solid var(--accent2)}
.chevron.right{border-top:22px solid transparent;border-bottom:22px solid transparent;border-left:28px solid var(--accent)}
h1.title{
  margin:0;
  font-size:clamp(38px,7vw,72px);
  font-weight:900;
  letter-spacing:6px;
  background:linear-gradient(to bottom,#fff 0%,#d6d6da 42%,#8e8e97 52%,#c7c7cd 100%);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
  text-shadow:0 3px 0 rgba(0,0,0,.35),0 6px 10px rgba(0,0,0,.4);
  text-transform:uppercase;
}
.build{color:var(--muted);letter-spacing:2px;font-size:13px;margin-top:-4px;text-shadow:0 1px 2px rgba(0,0,0,.6)}
.menu{margin-top:48px;width:min(360px,80vw);display:flex;flex-direction:column}
.mbtn{
  display:flex;
  align-items:center;
  gap:16px;
  background:transparent;
  border:none;
  color:var(--text);
  padding:14px 18px;
  font-size:17px;
  font-weight:600;
  letter-spacing:.3px;
  cursor:pointer;
  text-align:left;
  border-radius:4px;
  transition:background .12s ease;
}
.mbtn:hover{background:var(--btn-hover)}
.mbtn:active{background:var(--btn-active)}
.mbtn svg{width:22px;height:22px;flex:none;stroke:var(--text);fill:none;stroke-width:1.8}
.mbtn .sub{display:block;font-size:12px;font-weight:700;color:var(--accent2);letter-spacing:.5px}
.mbtn .label{display:flex;flex-direction:column;line-height:1.25}
.overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.55);
  backdrop-filter:blur(2px);
  display:none;
  align-items:center;
  justify-content:center;
  z-index:20;
  padding:20px;
}
.overlay.show{display:flex}
.modal{
  width:min(480px,100%);
  max-height:80vh;
  overflow:auto;
  background:var(--panel-strong);
  border:1px solid var(--border);
  border-radius:6px;
  box-shadow:0 20px 50px rgba(0,0,0,.55);
}
.modal-head{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--border)}
.modal-head h2{margin:0;font-size:18px;letter-spacing:1px;text-transform:uppercase}
.modal-close{background:none;border:none;color:var(--muted);font-size:20px;cursor:pointer;line-height:1;padding:4px 8px}
.modal-close:hover{color:var(--text)}
.modal-body{padding:16px 18px;font-size:14px;color:var(--text);line-height:1.6}
.row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);gap:18px}
.row:last-child{border-bottom:none}
.row span.k{color:var(--muted)}
input[type=range]{width:140px;accent-color:var(--accent2)}
.toggle{width:40px;height:22px;background:#444;border-radius:12px;position:relative;cursor:pointer;flex:none}
.toggle.on{background:var(--accent2)}
.toggle::after{content:"";position:absolute;top:2px;left:2px;width:18px;height:18px;border-radius:50%;background:#fff;transition:left .15s}
.toggle.on::after{left:20px}
.toast{
  position:fixed;
  left:50%;
  bottom:max(30px,env(safe-area-inset-bottom));
  transform:translateX(-50%) translateY(20px);
  max-width:calc(100vw - 32px);
  background:var(--panel-strong);
  border:1px solid var(--border);
  color:var(--text);
  padding:10px 18px;
  border-radius:5px;
  font-size:13px;
  text-align:center;
  opacity:0;
  transition:all .25s ease;
  z-index:40;
  pointer-events:none;
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.screen{
  position:fixed;
  inset:0;
  z-index:15;
  display:none;
  flex-direction:column;
  align-items:center;
  overflow:hidden;
  isolation:isolate;
  padding:28px 20px 20px;
}
.screen.show{display:flex}
.backlink{
  align-self:flex-start;
  background:none;
  border:none;
  color:var(--muted);
  font-size:14px;
  cursor:pointer;
  display:flex;
  align-items:center;
  gap:6px;
  margin-bottom:4px;
  padding:4px 0;
}
.backlink:hover{color:var(--text)}
.playgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;width:min(360px,86vw);margin-top:36px}
.pbtn{
  background:#141418;
  border:1px solid var(--border);
  border-radius:10px;
  padding:22px 10px;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:10px;
  cursor:pointer;
  color:var(--text);
  font-size:13.5px;
  font-weight:700;
  text-align:center;
  line-height:1.3;
  transition:background .12s,transform .1s;
}
.pbtn:hover{background:#1d1d24}
.pbtn:active{transform:scale(.97)}
.pbtn svg{width:26px;height:26px;stroke:var(--text);fill:none;stroke-width:1.8}
#scr-sectors{
  justify-content:center;
  background:
    radial-gradient(ellipse 65% 50% at 50% 43%,rgba(47,28,88,.5),transparent 76%),
    radial-gradient(ellipse at 50% 18%,#100a24 0%,#080613 55%,#030207 100%);
  padding:0;
}
#scr-sectors::before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  z-index:0;
  opacity:.55;
  background-image:
    radial-gradient(1.5px 1.5px at 10% 20%,#fff,transparent 60%),
    radial-gradient(1px 1px at 30% 65%,#fff,transparent 60%),
    radial-gradient(1.5px 1.5px at 70% 15%,#fff,transparent 60%),
    radial-gradient(1px 1px at 85% 55%,#fff,transparent 60%),
    radial-gradient(1.5px 1.5px at 50% 85%,#fff,transparent 60%),
    radial-gradient(1px 1px at 20% 90%,#fff,transparent 60%),
    radial-gradient(1px 1px at 92% 85%,#fff,transparent 60%);
  background-size:260px 260px;
}
.sector-canvas{position:absolute;inset:0;width:100%;height:100%;z-index:0;touch-action:none;cursor:grab;outline:none}
.sector-canvas:active{cursor:grabbing}
.hud-left{
  position:absolute;
  top:max(20px,env(safe-area-inset-top));
  left:max(20px,env(safe-area-inset-left));
  z-index:3;
  width:155px;
  font-size:12px;
  text-shadow:0 2px 7px #000;
}
.hud-left .backlink{margin-bottom:13px;padding:0;color:#aaa5bd}
.planet-tabs{display:flex;flex-direction:column;align-items:flex-start;gap:4px}
.ptab{
  display:flex;
  align-items:center;
  gap:7px;
  color:#a19bad;
  padding:5px 8px;
  border:1px solid transparent;
  background:transparent;
  font-size:12px;
  letter-spacing:.3px;
  cursor:pointer;
  text-align:left;
}
.ptab.active{color:#9be9ee;border-color:rgba(127,227,232,.2);border-bottom-color:#7fe3e8;background:rgba(23,32,53,.45)}
.pdiff{margin-top:13px;color:#a8a2b5;display:flex;align-items:center;gap:7px;cursor:default;padding:4px 8px;font-size:12px}
.sector-panel{
  position:absolute;
  z-index:4;
  left:50%;
  bottom:max(24px,calc(env(safe-area-inset-bottom) + 18px));
  transform:translateX(-50%);
  width:min(350px,calc(100vw - 34px));
  padding:0 16px 13px;
  background:linear-gradient(180deg,rgba(5,4,12,.86),rgba(3,3,8,.94));
  border:1px solid rgba(207,178,255,.13);
  border-top:1px solid rgba(255,204,131,.75);
  box-shadow:0 14px 34px rgba(0,0,0,.48),0 0 26px rgba(104,59,190,.12);
  backdrop-filter:blur(9px);
}
.sector-panel::before{
  content:"";
  position:absolute;
  left:16px;
  right:16px;
  top:0;
  height:1px;
  background:linear-gradient(90deg,transparent,rgba(255,206,136,.8),transparent);
}
.sector-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:12px 0 8px}
.sector-title-wrap{min-width:0;display:flex;flex-direction:column;gap:3px}
.sector-name{font-size:15px;font-weight:750;letter-spacing:.35px;line-height:1.25;overflow-wrap:anywhere}
.sector-kicker{font-size:9px;letter-spacing:1.6px;text-transform:uppercase;color:#8f849f}
.sector-index{color:#d6b985;font-size:10px;letter-spacing:1px;white-space:nowrap;padding-top:3px}
.sector-status{font-size:11px;color:#c5bfce;line-height:1.35;min-height:15px}
.sector-status.locked{color:#e28e8e}
.sector-status.capturable{color:#d2bbff}
.sector-threat{font-size:10px;color:#b7adca;line-height:1.35;margin-top:4px;letter-spacing:.15px}
.sector-threat[hidden]{display:none}
.resource-line{display:flex;align-items:center;gap:9px;border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08);padding:9px 0;margin-top:6px;min-height:39px}
.resource-label{font-size:10px;color:#a6a0b0;white-space:nowrap;flex:none}
.resource-icons{display:flex;align-items:center;justify-content:flex-start;gap:5px;flex:1;min-width:0;flex-wrap:wrap}
.resource-icon{display:inline-flex;align-items:center;justify-content:center;width:21px;height:21px;flex:none;filter:drop-shadow(0 1px 1px rgba(0,0,0,.7))}
.resource-icon svg{display:block;width:100%;height:100%;overflow:visible;shape-rendering:crispEdges}
.panel-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:10px}
.sector-info{min-height:26px;padding:5px 9px;border:1px solid rgba(255,255,255,.19);border-radius:3px;background:rgba(255,255,255,.035);color:#ded8eb;font-size:10px;letter-spacing:.2px;cursor:pointer;white-space:nowrap}
.sector-info:hover{background:rgba(255,255,255,.1)}
.sector-info[hidden]{display:none}
.sbtn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:9px;
  min-width:128px;
  background:linear-gradient(180deg,#f0a45d,#ce783e);
  border:1px solid rgba(255,218,168,.5);
  color:#211307;
  font-weight:800;
  padding:8px 15px;
  border-radius:4px;
  cursor:pointer;
  font-size:12px;
  text-shadow:0 1px 0 rgba(255,255,255,.15);
  box-shadow:0 3px 12px rgba(0,0,0,.3);
}
.sbtn:hover{filter:brightness(1.08)}
.sbtn:active{transform:translateY(1px)}
.sbtn:disabled{opacity:.4;cursor:not-allowed;filter:grayscale(.65)}
.sector-count{position:absolute;bottom:18px;left:max(20px,env(safe-area-inset-left));font-size:21px;font-weight:900;letter-spacing:1px;z-index:2;color:rgba(225,216,242,.76);text-shadow:0 2px 10px #000}
.mini-logo{position:absolute;bottom:17px;right:max(20px,env(safe-area-inset-right));text-align:right;z-index:2;text-shadow:0 2px 10px #000}
.mini-logo b{font-size:13px;font-weight:900;letter-spacing:1.5px;color:rgba(240,235,250,.82)}
.mini-logo small{display:block;color:#8e849e;font-size:9px;margin-top:-1px;letter-spacing:1px}

.research-trigger{display:inline-flex;align-items:center;justify-content:center;width:29px;height:29px;padding:5px;border:1px solid rgba(207,178,255,.25);border-radius:3px;background:rgba(125,96,179,.12);color:#e2d4ff;cursor:pointer;flex:none}
.research-trigger:hover{background:rgba(155,119,220,.24);border-color:rgba(207,178,255,.55)}
.research-trigger svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.panel-left-actions{display:flex;align-items:center;gap:7px;min-width:0}
.research-screen{position:fixed;inset:0;z-index:35;display:none;align-items:center;justify-content:center;padding:clamp(10px,2vw,28px);background:rgba(2,2,7,.83);backdrop-filter:blur(8px)}
.research-screen.show{display:flex}
.research-window{width:min(1500px,100%);height:min(920px,96vh);display:flex;flex-direction:column;overflow:hidden;background:linear-gradient(145deg,rgba(21,18,32,.985),rgba(5,5,11,.99));border:1px solid rgba(211,187,255,.22);box-shadow:0 24px 80px rgba(0,0,0,.68),0 0 44px rgba(93,57,165,.16);position:relative}
.research-header{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:13px 17px;border-bottom:1px solid rgba(255,255,255,.1);background:linear-gradient(90deg,rgba(100,69,145,.17),transparent 55%);flex:none}
.research-title{min-width:0;display:flex;flex-direction:column;gap:3px}
.research-title strong{font-size:15px;letter-spacing:2.2px;color:#f1edf8}
.research-title span{font-size:10px;color:#9b92ad;letter-spacing:.6px}
.research-header-right{display:flex;align-items:center;gap:10px}
.research-pool{display:flex;align-items:center;gap:7px;color:#b5adbf;font-size:10px;border:1px solid rgba(255,255,255,.09);padding:7px 9px;background:rgba(0,0,0,.2)}
.research-pool svg{width:16px;height:16px;stroke:#d1c1ff;fill:none;stroke-width:1.5}
.research-close{width:31px;height:31px;background:transparent;border:1px solid rgba(255,255,255,.14);color:#bcb4cc;font-size:18px;cursor:pointer}
.research-close:hover{background:rgba(255,255,255,.08);color:#fff}
.research-toolbar{display:flex;align-items:center;gap:6px;flex-wrap:wrap;padding:9px 13px;border-bottom:1px solid rgba(255,255,255,.075);flex:none}
.research-filter{border:1px solid transparent;background:transparent;color:#a69db8;padding:6px 10px;font-size:10px;letter-spacing:.4px;cursor:pointer}
.research-filter:hover{background:rgba(255,255,255,.05)}
.research-filter.active{border-color:rgba(194,164,255,.32);color:#e2d2ff;background:rgba(133,98,195,.18)}
.research-search{margin-left:auto;width:min(230px,32vw);background:rgba(0,0,0,.23);border:1px solid rgba(255,255,255,.13);color:#eee7f8;padding:7px 9px;font:inherit;font-size:11px;outline:none}
.research-search:focus{border-color:rgba(198,166,255,.65)}
.research-main{display:grid;grid-template-columns:minmax(0,1fr) 286px;min-height:0;flex:1}
.research-viewport{position:relative;overflow:auto;min-width:0;min-height:0;background-image:radial-gradient(circle at 50% 40%,rgba(104,72,155,.08),transparent 45%),linear-gradient(rgba(191,177,225,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(191,177,225,.035) 1px,transparent 1px);background-size:auto,28px 28px,28px 28px;scrollbar-color:#493d5e #0a0910;scrollbar-width:thin}
.research-canvas{position:relative;width:1190px;height:760px}
.research-connections{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none}
.research-link{stroke:rgba(174,153,211,.38);stroke-width:2;fill:none}
.research-link.available{stroke:rgba(235,193,119,.72)}
.research-node{position:absolute;width:158px;min-height:78px;display:flex;align-items:center;gap:9px;padding:10px 10px;background:linear-gradient(145deg,rgba(35,31,48,.96),rgba(12,11,20,.97));border:1px solid rgba(181,164,211,.24);color:#d0cadb;text-align:left;cursor:pointer;box-shadow:0 4px 11px rgba(0,0,0,.23);transition:border-color .12s,background .12s,filter .12s;z-index:2}
.research-node:hover{border-color:rgba(219,191,255,.65);background:linear-gradient(145deg,rgba(58,47,77,.98),rgba(16,13,27,.98))}
.research-node.selected{border-color:#eac58a;box-shadow:0 0 0 1px rgba(234,197,138,.14),0 0 18px rgba(221,169,101,.13)}
.research-node.researched{border-color:rgba(143,226,183,.55);background:linear-gradient(145deg,rgba(33,63,52,.92),rgba(12,22,21,.98))}
.research-node.locked{filter:saturate(.55);opacity:.66}
.research-node.available{border-color:rgba(234,197,138,.42)}
.research-node.sector-gated{border-style:dashed}
.research-glyph{width:33px;height:33px;flex:none;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.11);color:#d9c3ff;font-size:18px;text-shadow:0 0 10px currentColor}
.research-glyph.copper{color:#e9a05e}.research-glyph.lead{color:#afb9ca}.research-glyph.graphite{color:#b6a8d8}.research-glyph.silicon{color:#e4d782}.research-glyph.energy{color:#f0c56e}.research-glyph.defense{color:#e19b8d}.research-glyph.core{color:#9ce3de}
.research-node-copy{display:flex;flex-direction:column;gap:4px;min-width:0}
.research-node-copy strong{font-size:11px;line-height:1.25;font-weight:750;color:#ece7f4;overflow-wrap:anywhere}
.research-node-copy small{font-size:9px;line-height:1.25;color:#a49bb3}
.research-node-cost{font-size:9px;color:#e0bd85;white-space:nowrap}
.research-detail{border-left:1px solid rgba(255,255,255,.1);background:rgba(5,5,12,.57);min-width:0;overflow:auto;padding:15px 15px 18px;scrollbar-color:#493d5e #0a0910;scrollbar-width:thin}
.research-detail-kicker{font-size:9px;letter-spacing:1.8px;color:#9e91b5;text-transform:uppercase}
.research-detail-head{display:flex;align-items:center;gap:11px;margin:10px 0 11px}
.research-detail-glyph{height:46px;width:46px;display:flex;align-items:center;justify-content:center;border:1px solid rgba(207,178,255,.23);background:rgba(140,105,200,.12);font-size:24px;color:#e3d0ff;flex:none}
.research-detail-head h3{margin:0;font-size:17px;line-height:1.2;color:#f3edf9}
.research-detail-head p{margin:5px 0 0;font-size:10px;color:#a79eb6}
.research-state{display:inline-flex;align-items:center;gap:6px;margin-bottom:11px;padding:5px 7px;border:1px solid rgba(255,255,255,.12);font-size:9px;letter-spacing:.7px;color:#bcb2cf;background:rgba(255,255,255,.035)}
.research-state::before{content:"";width:6px;height:6px;border-radius:50%;background:#81768f}
.research-state.researched{color:#a9e7c4;border-color:rgba(143,226,183,.28)}.research-state.researched::before{background:#88d6ac}
.research-state.ready{color:#f2cf94;border-color:rgba(234,197,138,.28)}.research-state.ready::before{background:#eac58a}
.research-state.gated{color:#eaa3a3;border-color:rgba(222,119,119,.25)}.research-state.gated::before{background:#d77c7c}
.research-description{font-size:11px;line-height:1.55;color:#b9b1c8;margin:0 0 15px}
.research-detail-section{border-top:1px solid rgba(255,255,255,.09);padding-top:12px;margin-top:12px}
.research-detail-section h4{font-size:9px;font-weight:800;letter-spacing:1.5px;color:#9c92b0;text-transform:uppercase;margin:0 0 9px}
