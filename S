<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Blocklang Studio</title>
<style>
:root{
  --bg:#17181c;
  --border:#393c44;
  --text:#f1f2f5;
  --accent:#7456e8;
}
*{box-sizing:border-box}
html,body{width:100%;height:100%;margin:0}
body{
  background:var(--bg);
  color:var(--text);
  font-family:Arial,Helvetica,sans-serif;
  overflow:hidden;
}
#app{
  display:flex;
  width:100%;
  height:100%;
  min-height:0;
  gap:10px;
  padding:10px;
}
#left{
  display:flex;
  flex:0 0 40%;
  min-width:290px;
  min-height:0;
  flex-direction:column;
  gap:9px;
}
#editor{
  flex:1;
  min-height:100px;
  width:100%;
  resize:none;
  border:1px solid var(--border);
  border-radius:6px;
  padding:12px;
  background:#101115;
  color:#f4f4f4;
  outline:none;
  font:14px/1.55 Consolas,"Courier New",monospace;
  tab-size:4;
  white-space:pre;
  overflow:auto;
}
#editor:focus{border-color:var(--accent)}
#buttons{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
}
button{
  border:0;
  border-radius:5px;
  padding:9px 12px;
  background:#353842;
  color:#fff;
  font-size:13px;
  cursor:pointer;
}
button:hover{filter:brightness(1.15)}
button:active{filter:brightness(.9)}
#run{background:var(--accent)}
#stop{background:#a73737}
#build-tools{
  display:inline-flex;
  flex:0 0 auto;
  align-items:center;
  gap:2px;
  white-space:nowrap;
}
#virtual-key-toggle{
  flex:0 0 27px;
  min-width:27px;
  width:27px;
  height:27px;
  padding:0;
  font-weight:700;
  background:var(--accent);
}
#build-version{
  display:flex;
  align-items:center;
  justify-content:center;
  min-width:25px;
  padding:0 5px;
  color:#aeb3bf;
  font:12px Consolas,"Courier New",monospace;
}
#virtual-keyboard{
  display:flex;
  flex-direction:column;
  gap:6px;
  padding:9px;
  border:1px solid var(--border);
  border-radius:7px;
  background:#252830;
  touch-action:none;
  user-select:none;
  -webkit-user-select:none;
}
#virtual-keyboard[hidden]{display:none}
.key-row{
  display:flex;
  justify-content:center;
  gap:5px;
}
.key-row button{
  flex:1;
  min-width:0;
  min-height:39px;
  padding:7px 2px;
  border:1px solid #555a66;
  border-radius:5px;
  background:#414652;
  color:#fff;
  font-size:14px;
  font-weight:600;
  touch-action:none;
  user-select:none;
  -webkit-user-select:none;
}
.key-row button:active,
.key-row button.key-active{
  background:var(--accent);
  border-color:#a895ff;
}
.key-row-middle{padding:0 4%}
.key-row-bottom{padding:0 12%}
.key-row-controls button{min-height:36px;font-size:17px}
#console{
  flex:0 0 120px;
  min-height:55px;
  margin:0;
  border:1px solid var(--border);
  border-radius:6px;
  padding:9px;
  background:#101115;
  color:#d5d8df;
  overflow:auto;
  white-space:pre-wrap;
  overflow-wrap:anywhere;
  font:12px/1.45 Consolas,"Courier New",monospace;
}
#console-row{
  display:flex;
  flex:0 0 38px;
  gap:6px;
}
#console-input{
  flex:1;
  min-width:0;
  border:1px solid var(--border);
  border-radius:5px;
  outline:none;
  padding:8px 10px;
  background:#101115;
  color:#fff;
  font:13px Consolas,"Courier New",monospace;
}
#console-input:focus{border-color:var(--accent)}
#enter{background:var(--accent);min-width:58px}
#right{
  display:flex;
  flex:1;
  min-width:0;
  min-height:0;
  align-items:center;
  justify-content:center;
}
#stage{
  width:100%;
  height:auto;
  max-width:100%;
  max-height:100%;
  aspect-ratio:1/1;
  background:#000;
  border:1px solid #303039;
  position:relative;
  overflow:hidden;
}
#canvas{
  display:block;
  width:100%;
  height:100%;
  background:#000;
  image-rendering:pixelated;
  image-rendering:crisp-edges;
}
#pos-label{
  position:absolute;
  right:7px;
  bottom:6px;
  padding:3px 5px;
  background:rgba(0,0,0,.65);
  color:#bfc3ca;
  pointer-events:none;
  font:11px Consolas,"Courier New",monospace;
}
@media(max-width:760px){
  body{overflow:auto}
  #app{
    height:auto;
    min-height:100%;
    flex-direction:column-reverse;
    overflow:visible;
  }
  #right{flex:none;width:100%}
  #stage{width:min(100%,70vh);height:auto}
  #left{
    flex:none;
    width:100%;
    min-width:0;
    height:65vh;
  }
  #editor{flex:1}
}
</style>
</head>
<body>
<div id="app">
  <section id="left">
    <textarea id="editor" spellcheck="false" autocapitalize="off" autocomplete="off"></textarea>

    <div id="buttons">
      <button id="run">Ausführen</button>
      <button id="stop">Stopp</button>
      <button id="copy-console">Konsole kopieren</button>
      <button id="copy-code">Code kopieren</button>
      <span id="build-tools"><span id="build-version">12</span><button id="virtual-key-toggle" type="button" aria-label="Tastatur ein- oder ausblenden">T</button></span>
    </div>

    <div id="virtual-keyboard" hidden>
      <div class="key-row">
        <button type="button" data-key="1">1</button><button type="button" data-key="2">2</button><button type="button" data-key="3">3</button><button type="button" data-key="4">4</button><button type="button" data-key="5">5</button><button type="button" data-key="6">6</button><button type="button" data-key="7">7</button><button type="button" data-key="8">8</button><button type="button" data-key="9">9</button><button type="button" data-key="0">0</button>
      </div>
      <div class="key-row">
        <button type="button" data-key="q">Q</button><button type="button" data-key="w">W</button><button type="button" data-key="e">E</button><button type="button" data-key="r">R</button><button type="button" data-key="t">T</button><button type="button" data-key="y">Y</button><button type="button" data-key="u">U</button><button type="button" data-key="i">I</button><button type="button" data-key="o">O</button><button type="button" data-key="p">P</button>
      </div>
      <div class="key-row key-row-middle">
        <button type="button" data-key="a">A</button><button type="button" data-key="s">S</button><button type="button" data-key="d">D</button><button type="button" data-key="f">F</button><button type="button" data-key="g">G</button><button type="button" data-key="h">H</button><button type="button" data-key="j">J</button><button type="button" data-key="k">K</button><button type="button" data-key="l">L</button>
      </div>
      <div class="key-row key-row-bottom">
        <button type="button" data-key="z">Z</button><button type="button" data-key="x">X</button><button type="button" data-key="c">C</button><button type="button" data-key="v">V</button><button type="button" data-key="b">B</button><button type="button" data-key="n">N</button><button type="button" data-key="m">M</button>
      </div>
      <div class="key-row key-row-controls">
        <button type="button" data-key="minus">−</button><button type="button" data-key="left">←</button><button type="button" data-key="down">↓</button><button type="button" data-key="up">↑</button><button type="button" data-key="right">→</button><button type="button" data-key="plus">+</button>
      </div>
    </div>

    <pre id="console">bereit</pre>

    <div id="console-row">
      <input id="console-input" type="text" autocomplete="off" spellcheck="false">
      <button id="enter">Enter</button>
    </div>
  </section>

  <section id="right">
    <div id="stage">
      <canvas id="canvas" width="1000" height="1000"></canvas>
      <div id="pos-label">x: 0, y: 0</div>
    </div>
  </section>
</div>

<script>
const editor = document.getElementById("editor");
const runButton = document.getElementById("run");
const stopButton = document.getElementById("stop");
const consoleButton = document.getElementById("copy-console");
const codeButton = document.getElementById("copy-code");
const virtualKeyToggle = document.getElementById("virtual-key-toggle");
const virtualKeyboard = document.getElementById("virtual-keyboard");
const consoleElement = document.getElementById("console");
const consoleInput = document.getElementById("console-input");
const enterButton = document.getElementById("enter");
const canvas = document.getElementById("canvas");
const ctx = canvas.getContext("2d");
const positionLabel = document.getElementById("pos-label");

ctx.imageSmoothingEnabled = false;

let variables = Object.create(null);
const pressedKeys = new Set();
const functionDefinitions = Object.create(null);
const functionScopes = [];
let functionCallDepth = 0;

function isKeyPressName(name){
  return /^(?:[a-z0-9]|up|down|left|right|plus|minus)press$/i.test(String(name));
}

let px = 0;
let py = 0;
let penColor = 1;
let penWidth = 1;
let penIsOn = true;
let running = false;
let stopped = false;
let executionSteps = 0;
let outputLines = [];
let shouldClearConsole = false;
let breakRequested = false;
let continueRequested = false;
let loopDepth = 0;


const fastYield = (() => {
  if(typeof MessageChannel==="undefined"){
    return () => new Promise(resolve=>setTimeout(resolve,0));
  }

  const channel = new MessageChannel();
  const queue = [];

  channel.port1.onmessage = () => {
    const resolve = queue.shift();
    if(resolve) resolve();
  };

  return () => new Promise(resolve=>{
    queue.push(resolve);
    channel.port2.postMessage(null);
  });
})();

function writeConsole(text){
  consoleElement.textContent = String(text);
  consoleElement.scrollTop = consoleElement.scrollHeight;
}

function addOutput(text){
  outputLines.push(String(text));
  if(outputLines.length > 1500){
    outputLines = outputLines.slice(-1500);
  }
}

function roundNumber(value){
  return Math.round(value*1000)/1000;
}

function clamp(value,min,max){
  return Math.max(min,Math.min(max,value));
}

function updatePosition(){
  positionLabel.textContent =
    "x: "+roundNumber(px)+", y: "+roundNumber(py);
}

function canvasPoint(x,y){
  return {
    x:clamp(Math.round(Number(x)*10),0,999),
    y:clamp(Math.round((100-Number(y))*10),0,999)
  };
}

function clearCanvas(){
  ctx.fillStyle = "#000000";
  ctx.fillRect(0,0,1000,1000);
}

function hslToRgb(color){
  const match = String(color).match(
    /^hsl\(\s*([-+]?(?:\d+(?:\.\d*)?|\.\d+))\s*,\s*100%\s*,\s*50%\s*\)$/i
  );

  if(!match){
    throw new Error("Ungültige Stiftfarbe.");
  }

  const hue = ((Number(match[1])%360)+360)%360;
  const h = hue/60;
  const x = 255*(1-Math.abs(h%2-1));

  let r = 0;
  let g = 0;
  let b = 0;

  if(h<1){
    r=255;
    g=x;
  }else if(h<2){
    r=x;
    g=255;
  }else if(h<3){
    g=255;
    b=x;
  }else if(h<4){
    g=x;
    b=255;
  }else if(h<5){
    r=x;
    b=255;
  }else{
    r=255;
    b=x;
  }

  return {
    r:Math.round(r),
    g:Math.round(g),
    b:Math.round(b)
  };
}

function colorForPen(value){
  const number = Number(value);

  if(number===0||number===1||number===100){
    return "hsl(0,100%,50%)";
  }

  const hue = ((number-1)/99)*360;
  return "hsl("+hue+",100%,50%)";
}

function drawPixelLine(x1,y1,x2,y2,width,color){
  const a=canvasPoint(x1,y1);
  const b=canvasPoint(x2,y2);
  const w=clamp(Math.round(width),1,1000);
  ctx.save();
  ctx.strokeStyle=color;
  ctx.fillStyle=color;
  ctx.lineWidth=w;
  ctx.lineCap="round";
  ctx.lineJoin="round";
  if(a.x===b.x&&a.y===b.y){
    ctx.beginPath();
    ctx.arc(a.x,a.y,w/2,0,Math.PI*2);
    ctx.fill();
  }else{
    ctx.beginPath();
    ctx.moveTo(a.x,a.y);
    ctx.lineTo(b.x,b.y);
    ctx.stroke();
  }
  ctx.restore();
}

function gotoPosition(x,y){
  const nx = Number(x);
  const ny = Number(y);

  if(!Number.isFinite(nx)||!Number.isFinite(ny)){
    throw new Error("Ungültige Koordinaten.");
  }

  const nextX = clamp(nx,0,100);
  const nextY = clamp(ny,0,100);

  if(penIsOn){
    drawPixelLine(px,py,nextX,nextY,penWidth,colorForPen(penColor));
  }

  px = nextX;
  py = nextY;
  updatePosition();
}

function setPenColor(number){
  const input=Number(number);
  if(!Number.isFinite(input)) throw new Error("Stiftfarbe muss eine endliche Zahl sein.");
  penColor=((input-1)%100+100)%100+1;
}

function setPenWidth(number){
  const value = Math.trunc(Number(number));

  if(!Number.isFinite(value)||value<1||value>1000){
    throw new Error("Stiftdicke muss zwischen 1 und 1000 liegen.");
  }

  penWidth = value;
}

function getVariable(name){
  const key=String(name).toLowerCase();
  for(let i=functionScopes.length-1;i>=0;i--){
    if(Object.prototype.hasOwnProperty.call(functionScopes[i],key)) return functionScopes[i][key];
  }
  if(key==="x") return px;
  if(key==="y") return py;
  if(isKeyPressName(key)) return pressedKeys.has(key.slice(0,-5))?1:0;
  if(!Object.prototype.hasOwnProperty.call(variables,key)) throw new Error("Variable nicht deklariert: "+key);
  return variables[key];
}

function setVariable(name,value){
  const key=String(name).toLowerCase();
  for(let i=functionScopes.length-1;i>=0;i--){
    if(Object.prototype.hasOwnProperty.call(functionScopes[i],key)){
      functionScopes[i][key]=value;
      return;
    }
  }
  if(key==="x"||key==="y"||isKeyPressName(key)) throw new Error("Diese Werte sind schreibgeschützt.");
  if(!Object.prototype.hasOwnProperty.call(variables,key)) throw new Error("Variable nicht deklariert: "+key);
  variables[key]=value;
}

function defineVariable(name,value){
  const key=String(name).toLowerCase();
  if(functionScopes.length) functionScopes[functionScopes.length-1][key]=value;
  else{
    if(key==="x"||key==="y"||isKeyPressName(key)) throw new Error("Diese Werte sind schreibgeschützt.");
    variables[key]=value;
  }
}

function getArrayElement(name,index){
  const array=getVariable(name);
  const position=Number(index);
  if(!Array.isArray(array)) throw new Error("Keine Array-Variable: "+name);
  if(!Number.isInteger(position)||position<0||position>=array.length) throw new Error("Array-Index außerhalb des Bereichs: "+name+"["+index+"]");
  return array[position];
}

function setArrayElement(name,index,value,operator="="){
  const array=getVariable(name);
  const position=Number(index);
  if(!Array.isArray(array)) throw new Error("Keine Array-Variable: "+name);
  if(!Number.isInteger(position)||position<0||position>=array.length) throw new Error("Array-Index außerhalb des Bereichs: "+name+"["+index+"]");
  const oldValue=array[position];
  let result=value;
  if(operator==="+=") result=oldValue+value;
  if(operator==="-=") result=oldValue-value;
  if(operator==="*=") result=oldValue*value;
  if(operator==="/="){
    if(value===0) throw new Error("Division durch null.");
    result=oldValue/value;
  }
  array[position]=result;
  return result;
}

function parseValue(value){
  return resolveCompiledToken(compileToken(String(value).trim()));
}

function parseValue(value){
  const token = String(value).trim();

  if(/^[-+]?(?:\d+(?:\.\d*)?|\.\d+)$/.test(token)){
    return Number(token);
  }

  if(/^true$/i.test(token)) return true;
  if(/^false$/i.test(token)) return false;

  if(/^[a-z_$][a-z_$]*$/i.test(token)){
    return getVariable(token);
  }

  const compiled = compileToken(token);
  if(compiled.kind==="math") return resolveCompiledToken(compiled);

  throw new Error("Ungültiger Wert: "+token);
}

function evaluateCondition(condition){
  return evaluateBooleanExpression(condition);
}

function compileToken(raw){
  const token=String(raw).trim();
  if(/^[-+]?(?:\d+(?:\.\d*)?|\.\d+)$/.test(token)) return {kind:"num",data:Number(token)};
  if(/^true$/i.test(token)) return {kind:"bool",data:true};
  if(/^false$/i.test(token)) return {kind:"bool",data:false};
  if(/^[a-z_$][a-z_$]*$/i.test(token)) return {kind:"var",data:token.toLowerCase()};
  return {kind:"mathExpression",data:token};
}

function evaluateMathExpression(source){
  const tokens=String(source).match(/(?:\d+(?:\.\d*)?|\.\d+)|[a-z_$][a-z0-9_$]*|[()+\-*/^\[\],]/gi)||[];
  const compact=String(source).replace(/\s+/g,"");
  if(tokens.join("").toLowerCase()!==compact.toLowerCase()) throw new Error("Ungültiger mathematischer Ausdruck: "+source);
  let index=0;
  function primary(){
    const token=tokens[index++];
    if(token===undefined) throw new Error("Unvollständiger mathematischer Ausdruck.");
    if(token==="+") return primary();
    if(token==="-") return -primary();
    if(token==="("){
      const value=addition();
      if(tokens[index++]!==")") throw new Error("Schließende Klammer fehlt.");
      return value;
    }
    if(/^(?:\d|\.)/.test(token)) return Number(token);
    const name=token.toLowerCase();
    if(tokens[index]==="["){
      index++;
      const arrayIndex=addition();
      if(tokens[index++]!=="]") throw new Error("Schließende Array-Klammer fehlt.");
      return Number(getArrayElement(name,arrayIndex));
    }
    if(tokens[index]==="("){
      index++;
      const args=[];
      if(tokens[index]!==")"){
        while(true){
          const possibleName=tokens[index];
          const isArrayArgument=/^[a-z_$][a-z0-9_$]*$/i.test(possibleName||"")&&
            (tokens[index+1]===","||tokens[index+1]===")")&&
            Array.isArray(getVariable(possibleName));
          if(isArrayArgument){
            args.push(getVariable(possibleName));
            index++;
          }else{
            args.push(addition());
          }
          if(tokens[index]===","){index++;continue;}
          break;
        }
      }
      if(tokens[index++]!==")") throw new Error("Schließende Funktionsklammer fehlt.");
      if(name==="sin"||name==="cos"){
        if(args.length!==1) throw new Error(name+" benötigt genau einen Parameter.");
        return name==="sin"?Math.sin(args[0]):Math.cos(args[0]);
      }
      return Number(callFunction(name,args));
    }
    const value=getVariable(name);
    if(Array.isArray(value)) throw new Error("Ein Array benötigt einen Index: "+name+"[0]");
    return Number(value);
  }
  function power(){
    const value=primary();
    if(tokens[index]==="^"){index++;return Math.pow(value,power());}
    return value;
  }
  function multiplication(){
    let value=power();
    while(tokens[index]==="*"||tokens[index]==="/"){
      const op=tokens[index++];
      const right=power();
      if(op==="/"&&right===0) throw new Error("Division durch null.");
      value=op==="*"?value*right:value/right;
    }
    return value;
  }
  function addition(){
    let value=multiplication();
    while(tokens[index]==="+"||tokens[index]==="-"){
      const op=tokens[index++];
      const right=multiplication();
      value=op==="+"?value+right:value-right;
    }
    return value;
  }
  const result=addition();
  if(index!==tokens.length||!Number.isFinite(result)) throw new Error("Ungültiger mathematischer Ausdruck: "+source);
  return result;
}

function stripOuterParentheses(source){
  let text=String(source).trim();
  while(text[0]==="("&&text[text.length-1]===")"){
    let depth=0,wraps=true;
    for(let i=0;i<text.length;i++){
      if(text[i]==="(") depth++;
      if(text[i]===")") depth--;
      if(depth===0&&i<text.length-1){wraps=false;break;}
    }
    if(!wraps) break;
    text=text.slice(1,-1).trim();
  }
  return text;
}

function splitLogicalExpression(source,operator){
  let depth=0;
  for(let i=0;i<source.length-1;i++){
    if(source[i]==="(") depth++;
    else if(source[i]===")") depth--;
    else if(depth===0&&source.slice(i,i+2)===operator) return [source.slice(0,i).trim(),source.slice(i+2).trim()];
  }
  return null;
}

function findComparisonOperator(source){
  let depth=0;
  for(let i=0;i<source.length;i++){
    const character=source[i];
    if(character==="("){depth++;continue;}
    if(character===")"){depth--;continue;}
    if(depth!==0) continue;
    const pair=source.slice(i,i+2);
    if(pair==="=="||pair==="!="||pair===">="||pair==="<=") return {index:i,operator:pair};
    if(character===">"||character==="<"||character==="=") return {index:i,operator:character};
  }
  return null;
}

function evaluateBooleanExpression(source){
  const text=stripOuterParentheses(source);
  if(!text) throw new Error("Die Bedingung ist leer.");
  const orParts=splitLogicalExpression(text,"||");
  if(orParts) return evaluateBooleanExpression(orParts[0])||evaluateBooleanExpression(orParts[1]);
  const andParts=splitLogicalExpression(text,"&&");
  if(andParts) return evaluateBooleanExpression(andParts[0])&&evaluateBooleanExpression(andParts[1]);
  if(text[0]==="!"&&text[1]!=="=") return !evaluateBooleanExpression(text.slice(1));
  if(/^true$/i.test(text)) return true;
  if(/^false$/i.test(text)) return false;
  const comparison=findComparisonOperator(text);
  if(comparison){
    const left=parseValue(text.slice(0,comparison.index));
    const right=parseValue(text.slice(comparison.index+comparison.operator.length));
    switch(comparison.operator){
      case "=":
      case "==": return left===right;
      case "!=": return left!==right;
      case ">": return left>right;
      case "<": return left<right;
      case ">=": return left>=right;
      case "<=": return left<=right;
    }
  }
  return Boolean(parseValue(text));
}

function executeFunctionStatements(nodes){
  for(const node of nodes){
    if(!node) continue;
    if(node.type==="sequence"||node.type==="block"){
      const nested=executeFunctionStatements(node.body);
      if(nested.returned) return nested;
      continue;
    }
    if(node.type==="return") return {returned:true,value:resolveCompiledToken(compileToken(node.value))};
    if(node.type==="declare"){defineVariable(node.name,node.value);continue;}
    if(node.type==="declareExpr"){defineVariable(node.name,resolveCompiledToken(compileToken(node.value)));continue;}
    if(node.type==="arrayDeclare"){
      const size=resolveCompiledToken(compileToken(node.size));
      if(!Number.isInteger(size)||size<0||size>100000) throw new Error("Ungültige Array-Größe.");
      defineVariable(node.name,new Array(size).fill(0));
      continue;
    }
    if(node.type==="arrayAssign"){
      setArrayElement(node.name,resolveCompiledToken(compileToken(node.index)),resolveCompiledToken(compileToken(node.value)),node.operator);
      continue;
    }
    if(node.type==="assign"){
      const oldValue=getVariable(node.name),next=resolveCompiledToken(compileToken(node.value));
      let result=next;
      if(node.operator==="+=") result=oldValue+next;
      if(node.operator==="-=") result=oldValue-next;
      if(node.operator==="*=") result=oldValue*next;
      if(node.operator==="/="){if(next===0) throw new Error("Division durch null.");result=oldValue/next;}
      setVariable(node.name,result);
      continue;
    }
    if(node.type==="if"){
      const branch=evaluateCompiledCondition(compileCondition(node.condition))?node.body:(node.elseBody||[]);
      const nested=executeFunctionStatements(branch);
      if(nested.returned) return nested;
      continue;
    }
    throw new Error("Dieser Befehl wird innerhalb einer Funktion nicht unterstützt.");
  }
  return {returned:false,value:undefined};
}

function callFunction(name,args){
  const key=String(name).toLowerCase();
  const definition=functionDefinitions[key];
  if(!definition) throw new Error("Funktion nicht definiert: "+key);
  if(args.length!==definition.params.length) throw new Error("Funktion "+key+" erwartet "+definition.params.length+" Parameter.");
  if(functionCallDepth>=100) throw new Error("Maximale Funktionstiefe überschritten.");
  const scope=Object.create(null);
  definition.params.forEach((parameter,index)=>scope[parameter]=args[index]);
  functionScopes.push(scope);
  functionCallDepth++;
  try{
    const result=executeFunctionStatements(definition.body);
    if(!result.returned) throw new Error("Funktion "+key+" benötigt einen return-Wert.");
    return result.value;
  }finally{
    functionCallDepth--;
    functionScopes.pop();
  }
}

function resolveCompiledToken(compiled){
  switch(compiled.kind){
    case "num":
    case "bool":
      return compiled.data;
    case "var":
      return getVariable(compiled.data);
    case "mathExpression":
      return evaluateMathExpression(compiled.data);
    case "math":{
      const value = resolveCompiledToken(compiled.argument);
      return compiled.operator==="sin"?Math.sin(value):Math.cos(value);
    }
    default:
      throw new Error("Ungültiger Wert: "+compiled.data);
  }
}

function compileCondition(raw){
  return {mode:"expression",data:String(raw).trim()};
}

function evaluateCompiledCondition(compiled){
  if(compiled.mode==="expression") return evaluateBooleanExpression(compiled.data);
  if(compiled.mode==="literal") return compiled.data;
  if(compiled.mode==="error") throw new Error("Ungültige Bedingung: "+compiled.data);
  throw new Error("Ungültige Bedingung.");
}

function decodeCompactPrefix(prefix,candidates){
  if(!prefix) return [];

  const text = String(prefix).toLowerCase();
  const names = [...new Set(candidates.map(name=>String(name).toLowerCase()))]
    .filter(name=>/^[a-z_$][a-z_$]*$/.test(name))
    .sort((a,b)=>b.length-a.length);

  function search(position,result){
    if(position===text.length){
      return result;
    }

    for(const name of names){
      const token = name+"0";

      if(text.startsWith(token,position)){
        const found = search(
          position+token.length,
          result.concat([{type:"declare",name,value:0}])
        );

        if(found) return found;
      }
    }

    return null;
  }

  return search(0,[]) || [];
}

function getDeclaredNames(source){
  const names = new Set();
  const lines = String(source).split(/\r?\n/);

  for(const line of lines){
    let match;

    const explicitDeclarations=/\b(?:let|var)\s+([a-z_$][a-z_$]*)\s*=/ig;
    while((match=explicitDeclarations.exec(line))!==null){
      names.add(match[1].toLowerCase());
    }

    const arrayDeclarations=/\barray\s+([a-z_$][a-z_$]*)\s*\[/ig;
    while((match=arrayDeclarations.exec(line))!==null){
      names.add(match[1].toLowerCase());
    }

    const functionDeclarations=/\b(?:function|fn)\s+[a-z_$][a-z_$]*\s*\(([^)]*)\)/ig;
    while((match=functionDeclarations.exec(line))!==null){
      const parameters=match[1].split(",");
      for(const parameter of parameters){
        const name=parameter.trim().toLowerCase();
        if(/^[a-z_$][a-z_$]*$/i.test(name)) names.add(name);
      }
    }

    const spaced = /([a-z_$][a-z_$]*)[ \t]+([-+]?(?:\d+(?:\.\d*)?|\.\d+))/ig;

    while((match=spaced.exec(line))!==null){
      names.add(match[1].toLowerCase());
    }

    const compactEnd =
      /(?:^|[;\s])((?:[a-z_$]+0)+)(?=$|[;\s{}]|(?:penon|penoff|pensize|pencolor|color|thickness|penwidth|goto|move|clear|stop|cls|break|continue|print))/ig;

    while((match=compactEnd.exec(line))!==null){
      const declarations = match[1].match(/[a-z_$]+(?=0)/ig) || [];

      for(const name of declarations){
        names.add(name.toLowerCase());
      }
    }

    const compactCondition =
      /(elseif|else\s*if|if|while)\s*([a-z_$][a-z_$]*)\s*(==|!=|>=|<=|=|>|<)\s*([a-z_$][a-z_$]*|[-+]?(?:\d+(?:\.\d*)?|\.\d+))/ig;

    while((match=compactCondition.exec(line))!==null){
      let prefix = line.slice(0,match.index);
      prefix = prefix.replace(/^.*\belse\s+/i,"");

      const candidates = [match[2]];

      if(/^[a-z_$][a-z_$]*$/i.test(match[4])){
        candidates.push(match[4]);
      }

      const decoded = decodeCompactPrefix(prefix,candidates);

      for(const declaration of decoded){
        names.add(declaration.name);
      }
    }
  }

  return names;
}

class ProgramParser{
  constructor(source){
    this.source = String(source);
    this.position = 0;
  }

  rest(){
    return this.source.slice(this.position);
  }

  starts(text){
    return this.rest().toLowerCase().startsWith(text.toLowerCase());
  }

  skipSpace(){
    while(
      this.position<this.source.length &&
      /\s/.test(this.source[this.position])
    ){
      this.position++;
    }
  }

  skipSeparators(){
    while(this.position<this.source.length){
      const character = this.source[this.position];

      if(/\s/.test(character)||character===";"){
        this.position++;
      }else{
        break;
      }
    }
  }

  parseCompactControlPrefix(){
    const match = this.rest().match(
      /^(.+?)(if|while)\s*([a-z_$][a-z_$]*)\s*(==|!=|>=|<=|=|>|<)\s*([a-z_$][a-z_$]*|[-+]?(?:\d+(?:\.\d*)?|\.\d+))\s*\{/i
    );

    if(!match) return null;

    const candidates = [match[3]];

    if(/^[a-z_$][a-z_$]*$/i.test(match[5])){
      candidates.push(match[5]);
    }

    const declarations = decodeCompactPrefix(match[1],candidates);

    if(!declarations.length) return null;

    this.position += match[1].length;

    const control = match[2].toLowerCase()==="while"
      ? this.parseWhile()
      : this.parseIf();

    return {
      type:"sequence",
      body:declarations.concat([control])
    };
  }

  readCompactDeclarationsBeforeIf(){
    const prefixMatch = this.rest().match(
      /^((?:[a-z_$][a-z_$]*0)+)(?=if\s*[^{}]+\{)/i
    );

    if(!prefixMatch) return [];

    const following = this.rest().slice(prefixMatch[1].length);
    const conditionMatch = following.match(
      /^if\s*([a-z_$][a-z_$]*)\s*(==|!=|>=|<=|=|>|<)\s*([a-z_$][a-z_$]*|[-+]?(?:\d+(?:\.\d*)?|\.\d+))\s*\{/i
    );

    if(!conditionMatch) return [];

    const candidates = [conditionMatch[1]];

    if(/^[a-z_$][a-z_$]*$/i.test(conditionMatch[3])){
      candidates.push(conditionMatch[3]);
    }

    const declarations = decodeCompactPrefix(prefixMatch[1],candidates);

    if(!declarations.length) return [];

    this.position += prefixMatch[1].length;
    this.skipSpace();

    return declarations;
  }

  parseCompactAssignmentPrefix(){
    const match = this.rest().match(
      /^(.+?)([a-z_$][a-z_$]*)(\+=|-=|\*=|\/=|=)([-+]?(?:\d+(?:\.\d*)?|\.\d+)|(?:sin|cos)\s*\([^()]+\)|[a-z_$][a-z_$]*)/i
    );

    if(!match) return null;

    const candidates = [match[2]];

    if(/^[a-z_$][a-z_$]*$/i.test(match[4])){
      candidates.push(match[4]);
    }

    const declarations = decodeCompactPrefix(match[1],candidates);

    if(!declarations.length) return null;

    this.position += match[1].length;

    const assignment = this.parseStatement();

    return {
      type:"sequence",
      body:declarations.concat([assignment])
    };
  }

  readExpressionUntilBoundary(){
    const start=this.position;
    let parentheses=0,brackets=0;
    while(this.position<this.source.length){
      const character=this.source[this.position];
      if(character==="(") parentheses++;
      else if(character===")") parentheses--;
      else if(character==="[") brackets++;
      else if(character==="]") brackets--;
      if(parentheses===0&&brackets===0&&/[;\n\r{}]/.test(character)) break;
      this.position++;
    }
    return this.source.slice(start,this.position).trim();
  }

  parseFunction(){
    const header=this.rest().match(/^(?:function|fn)\s+([a-z_$][a-z_$]*)\s*\(/i);
    if(!header) return null;
    const name=header[1].toLowerCase();
    this.position+=header[0].length;
    const start=this.position;
    let depth=1;
    while(this.position<this.source.length&&depth>0){
      const character=this.source[this.position++];
      if(character==="(") depth++;
      if(character===")") depth--;
    }
    if(depth!==0) throw new Error("Funktionsparameter: schließende Klammer fehlt.");
    const parameterText=this.source.slice(start,this.position-1).trim();
    const params=parameterText?parameterText.split(",").map(value=>value.trim().toLowerCase()):[];
    if(params.some(value=>! /^[a-z_$][a-z_$]*$/i.test(value))||new Set(params).size!==params.length) throw new Error("Ungültige oder doppelte Funktionsparameter.");
    this.skipSpace();
    return {type:"functionDef",name,params,body:this.readBlock()};
  }

  readBlock(){
    this.skipSpace();

    if(this.source[this.position]!=="{"){
      throw new Error("Vor dem Block fehlt eine geschweifte Klammer: {");
    }

    this.position++;
    return this.parseBlock(true);
  }

  parseBlock(expectClose){
    const nodes = [];

    while(this.position<this.source.length){
      this.skipSeparators();

      if(this.position>=this.source.length) break;

      if(this.source[this.position]==="}"){
        if(!expectClose){
          throw new Error("Unerwartete schließende Klammer: }");
        }

        this.position++;
        return nodes;
      }

      const sourceLine=this.source.slice(0,this.position).split(/\r?\n/).length;
      try{
        const node=this.parseStatement();
        if(node&&typeof node==="object"&&node.sourceLine===undefined) node.sourceLine=sourceLine;
        nodes.push(node);
      }catch(error){
        if(!error.blocklangLine){error.message="Zeile "+sourceLine+": "+error.message;error.blocklangLine=true;}
        throw error;
      }
    }

    if(expectClose){
      throw new Error("Schließende Klammer fehlt: }");
    }

    return nodes;
  }

  readControlCondition(){
    this.skipSpace();

    const braceIndex = this.source.indexOf("{",this.position);

    if(braceIndex<0){
      throw new Error("Nach der Bedingung fehlt ein Block mit { }.");
    }

    const condition = this.source.slice(this.position,braceIndex).trim();
    this.position = braceIndex;

    if(!condition){
      throw new Error("Die Bedingung ist leer.");
    }

    if(isKeyPressName(condition)){
      return condition+"=1";
    }

    if(/^[a-z_$][a-z_$]*$/i.test(condition)){
      return condition+"=0";
    }

    return condition;
  }

  parseIf(){
    this.position += 2;

    const condition = this.readControlCondition();
    const body = this.readBlock();

    const node = {
      type:"if",
      condition,
      body,
      elseBody:null
    };

    this.skipSeparators();

    if(this.starts("elseif")){
      this.position += 6;

      const nestedCondition = this.readControlCondition();
      const nestedBody = this.readBlock();

      node.elseBody = [{
        type:"if",
        condition:nestedCondition,
        body:nestedBody,
        elseBody:null
      }];

      this.attachElseChain(node.elseBody[0]);
      return node;
    }

    if(this.starts("else")){
      this.position += 4;
      this.skipSpace();

      const declarations = this.readCompactDeclarationsBeforeIf();

      if(this.starts("if")){
        const nested = this.parseIf();

        node.elseBody = declarations.length
          ? [{type:"sequence",body:declarations.concat([nested])}]
          : [nested];
      }else{
        const elseBody = this.readBlock();

        node.elseBody = declarations.length
          ? declarations.concat(elseBody)
          : elseBody;
      }
    }

    return node;
  }

  attachElseChain(node){
    this.skipSeparators();

    if(this.starts("elseif")){
      this.position += 6;

      const condition = this.readControlCondition();
      const body = this.readBlock();

      node.elseBody = [{
        type:"if",
        condition,
        body,
        elseBody:null
      }];

      this.attachElseChain(node.elseBody[0]);
      return;
    }

    if(this.starts("else")){
      this.position += 4;
      this.skipSpace();

      const declarations = this.readCompactDeclarationsBeforeIf();

      if(this.starts("if")){
        node.elseBody = declarations.length
          ? [{type:"sequence",body:declarations.concat([this.parseIf()])}]
          : [this.parseIf()];
      }else{
        const body = this.readBlock();

        node.elseBody = declarations.length
          ? declarations.concat(body)
          : body;
      }
    }
  }

  parseWhile(){
    this.position += 5;

    const condition = this.readControlCondition();
    const body = this.readBlock();

    return {type:"while",condition,body};
  }

  readSimpleCommand(){
    const remaining = this.rest();
    let match;

    match = remaining.match(/^(?:goto|move)\s*/i);
    if(match){
      const start=this.position+match[0].length;
      let comma=-1,depth=0;
      for(let i=start;i<this.source.length;i++){
        const character=this.source[i];
        if(character==="(") depth++;
        if(character===")"){
          depth--;
          if(depth<0) throw new Error("Unerwartete schließende Klammer.");
        }
        if(character===","&&depth===0){comma=i;break;}
        if(/[;\n\r{}]/.test(character)&&depth===0) break;
      }
      if(comma<0) throw new Error("goto benötigt zwei Zahlenwerte, getrennt durch ein Komma.");
      let end=comma+1;
      depth=0;
      while(end<this.source.length){
        const character=this.source[end];
        if(character==="(") depth++;
        if(character===")"){
          depth--;
          if(depth<0) throw new Error("Unerwartete schließende Klammer.");
        }
        if(/[;\n\r{}]/.test(character)&&depth===0) break;
        end++;
      }
      const first=this.source.slice(start,comma).trim();
      const second=this.source.slice(comma+1,end).trim();
      if(!first||!second) throw new Error("goto benötigt zwei Zahlenwerte.");
      this.position=end;
      return {type:"command",command:"goto",args:[first,second]};
    }

    match = remaining.match(/^(?:pencolor|color)\s*/i);
    if(match){
      this.position+=match[0].length;
      const value=this.readExpressionUntilBoundary();
      if(!value) throw new Error("pencolor benötigt einen Wert.");
      return {type:"command",command:"color",args:[value]};
    }

    match = remaining.match(/^(?:thickness|penwidth|pensize)\s*/i);
    if(match){
      this.position+=match[0].length;
      const value=this.readExpressionUntilBoundary();
      if(!value) throw new Error("pensize benötigt einen Wert.");
      return {type:"command",command:"thickness",args:[value]};
    }

    match = remaining.match(/^(penoff|penon|clear|stop|cls|break|continue)/i);
    if(match){
      this.position+=match[0].length;
      return {type:"command",command:match[1].toLowerCase(),args:[]};
    }

    if(/^print/i.test(remaining)){
      this.position+=5;
      this.skipSpace();
      let value="";
      let literal=false;
      if(this.source[this.position]==='"'||this.source[this.position]==="'"){
        literal=true;
        const quote=this.source[this.position++];
        const end=this.source.indexOf(quote,this.position);
        if(end<0) throw new Error("Bei print fehlt das schließende Anführungszeichen.");
        value=this.source.slice(this.position,end);
        this.position=end+1;
      }else{
        value=this.readExpressionUntilBoundary();
      }
      return {type:"command",command:"print",args:[value],literal};
    }



    return null;
  }

  parseStatement(){
    this.skipSeparators();

    if(this.position>=this.source.length){
      return {type:"empty"};
    }

    if(this.source[this.position]==="{"){
      return {type:"block",body:this.readBlock()};
    }

    if(this.source[this.position]==="}"){
      throw new Error("Unerwartete schließende Klammer: }");
    }

    const label = this.rest().match(/^([a-z_$][a-z_$]*):/i);

    if(label){
      this.position += label[0].length;
      return {type:"empty"};
    }

    const functionNode=this.parseFunction();
    if(functionNode) return functionNode;

    const returnCommand=this.rest().match(/^return\b/i);
    if(returnCommand){
      this.position+=returnCommand[0].length;
      const value=this.readExpressionUntilBoundary();
      if(!value) throw new Error("return benötigt einen Wert.");
      return {type:"return",value};
    }

    const explicitDeclaration=this.rest().match(/^(?:let|var)\s+([a-z_$][a-z_$]*)\s*=\s*/i);
    if(explicitDeclaration){
      this.position+=explicitDeclaration[0].length;
      const value=this.readExpressionUntilBoundary();
      if(!value) throw new Error("Deklaration benötigt einen Startwert.");
      return {type:"declareExpr",name:explicitDeclaration[1].toLowerCase(),value};
    }

    const arrayDeclaration=this.rest().match(/^array\s+([a-z_$][a-z_$]*)\s*\[/i);
    if(arrayDeclaration){
      this.position+=arrayDeclaration[0].length;
      const start=this.position;
      let depth=1;
      while(this.position<this.source.length&&depth>0){
        const character=this.source[this.position++];
        if(character==="[") depth++;
        if(character==="]") depth--;
      }
      if(depth!==0) throw new Error("Array-Deklaration: schließende Klammer fehlt.");
      const size=this.source.slice(start,this.position-1).trim();
      if(!size) throw new Error("Array benötigt eine Größe.");
      return {type:"arrayDeclare",name:arrayDeclaration[1].toLowerCase(),size};
    }

    const waitCommand=this.rest().match(/^wait(?=$|[\s(+\-.\d])/i);
    if(waitCommand){
      this.position+=waitCommand[0].length;
      const duration=this.readExpressionUntilBoundary();
      if(!duration) throw new Error("wait benötigt eine Millisekunden-Zahl, zum Beispiel wait 1000.");
      return {type:"command",command:"wait",args:[duration]};
    }

    const compactControl = this.parseCompactControlPrefix();

    if(compactControl){
      return compactControl;
    }

    const trueLoop = this.rest().match(/^true\b/i);

    if(trueLoop){
      this.position += trueLoop[0].length;
      this.skipSpace();

      if(this.source[this.position]!=="{"){
        throw new Error("Nach true fehlt ein Block mit { }.");
      }

      return {
        type:"while",
        condition:"true",
        body:this.readBlock()
      };
    }

    if(this.starts("if")){
      return this.parseIf();
    }

    if(this.starts("while")){
      return this.parseWhile();
    }

    if(this.starts("else")){
      throw new Error("else benötigt einen vorherigen if-Block.");
    }

    const compactDeclarations = this.rest().match(
      /^((?:[a-z_$]+0)+)(?=$|[\s;{}]|(?:penoff|penon|pensize|pencolor|color|thickness|penwidth|goto|move|wait|clear|stop|cls|break|print|true))/i
    );

    if(compactDeclarations){
      this.position += compactDeclarations[0].length;

      const declarations = compactDeclarations[0]
        .match(/[a-z_$]+(?=0)/ig)
        .map(name=>({
          type:"declare",
          name:name.toLowerCase(),
          value:0
        }));

      return declarations.length===1
        ? declarations[0]
        : {type:"sequence",body:declarations};
    }

    const arrayAssignment=this.rest().match(/^([a-z_$][a-z_$]*)\s*\[/i);
    if(arrayAssignment){
      const name=arrayAssignment[1].toLowerCase();
      this.position+=arrayAssignment[0].length;
      const indexStart=this.position;
      let depth=1;
      while(this.position<this.source.length&&depth>0){
        const character=this.source[this.position++];
        if(character==="[") depth++;
        if(character==="]") depth--;
      }
      if(depth!==0) throw new Error("Array-Zuweisung: schließende Klammer fehlt.");
      const index=this.source.slice(indexStart,this.position-1).trim();
      this.skipSpace();
      const operatorMatch=this.rest().match(/^(\+=|-=|\*=|\/=|=)/);
      if(operatorMatch){
        this.position+=operatorMatch[0].length;
        const value=this.readExpressionUntilBoundary();
        if(!index||!value) throw new Error("Array-Zuweisung benötigt Index und Wert.");
        return {type:"arrayAssign",name,index,operator:operatorMatch[0],value};
      }
      throw new Error("Ein Array-Zugriff als Befehl benötigt eine Zuweisung.");
    }

    const command = this.readSimpleCommand();

    if(command){
      return command;
    }

    let match = this.rest().match(
      /^([a-z_$][a-z_$]*)(\+\+|--)(?=$|[\s;{}])/i
    );

    if(match){
      this.position += match[0].length;

      return {
        type:"assign",
        name:match[1].toLowerCase(),
        operator:match[2]==="++"?"+=":"-=",
        value:"1"
      };
    }

    const compactAssignment = this.parseCompactAssignmentPrefix();

    if(compactAssignment){
      return compactAssignment;
    }

    match = this.rest().match(
      /^([a-z_$][a-z_$]*)[ \t]+([-+]?(?:\d+(?:\.\d*)?|\.\d+))/
    );

    if(match){
      this.position += match[0].length;

      return {
        type:"declare",
        name:match[1].toLowerCase(),
        value:Number(match[2])
      };
    }

    match = this.rest().match(
      /^([a-z_$][a-z_$]*)0(?=$|[\s;{}])/i
    );

    if(match){
      this.position += match[0].length;

      return {
        type:"declare",
        name:match[1].toLowerCase(),
        value:0
      };
    }

    match = this.rest().match(/^([a-z_$][a-z_$]*)(\+=|-=|\*=|\/=|=)/i);
    if(match){
      this.position+=match[0].length;
      const value=this.readExpressionUntilBoundary();
      if(!value) throw new Error("Zuweisung benötigt einen Wert.");
      return {type:"assign",name:match[1].toLowerCase(),operator:match[2],value};
    }

    const unknown = this.rest().match(/^[^\s;{}]+/);

    if(unknown){
      this.position += unknown[0].length;
      throw new Error("Unbekannter Befehl: "+unknown[0]);
    }

    throw new Error("Der Befehl konnte nicht gelesen werden.");
  }

  parse(){
    return this.parseBlock(false);
  }
}

async function executeNodes(nodes){
  for(const node of nodes){
    if(stopped||breakRequested||continueRequested) return;
    executionSteps++;
    if(executionSteps%100===0){
      await fastYield();
      if(stopped||breakRequested||continueRequested) return;
    }
    try{
      await executeNode(node);
    }catch(error){
      if(!error.blocklangLine&&node&&node.sourceLine){
        error.message="Zeile "+node.sourceLine+": "+error.message;
        error.blocklangLine=true;
      }
      throw error;
    }
  }
}

async function executeNode(node){
  if(stopped||breakRequested||continueRequested||!node) return;

  switch(node.type){
    case "empty":
      return;

    case "block":
      await executeNodes(node.body);
      return;

    case "sequence":
      await executeNodes(node.body);
      return;

    case "declare":
      defineVariable(node.name,node.value);
      addOutput(node.name+" = "+node.value);
      return;

    case "declareExpr":{
      const value=resolveCompiledToken(compileToken(node.value));
      defineVariable(node.name,value);
      addOutput(node.name+" = "+value);
      return;
    }

    case "arrayDeclare":{
      const size=resolveCompiledToken(compileToken(node.size));
      if(!Number.isInteger(size)||size<0||size>100000) throw new Error("Array-Größe muss eine ganze Zahl zwischen 0 und 100000 sein.");
      defineVariable(node.name,new Array(size).fill(0));
      addOutput(node.name+" = Array["+size+"]");
      return;
    }

    case "arrayAssign":{
      if(!node._compiledIndex) node._compiledIndex=compileToken(node.index);
      if(!node._compiledValue) node._compiledValue=compileToken(node.value);
      const index=resolveCompiledToken(node._compiledIndex);
      const value=resolveCompiledToken(node._compiledValue);
      const result=setArrayElement(node.name,index,value,node.operator);
      addOutput(node.name+"["+index+"] = "+roundNumber(Number(result)));
      return;
    }

    case "functionDef":
      functionDefinitions[node.name]=node;
      return;

    case "return":
      throw new Error("return kann nur innerhalb einer Funktion verwendet werden.");

    case "assign":{
      const oldValue = getVariable(node.name);

      if(!node._compiledValue){
        node._compiledValue = compileToken(node.value);
      }

      const newValue = resolveCompiledToken(node._compiledValue);
      let result;

      switch(node.operator){
        case "=":
          result = newValue;
          break;
        case "+=":
          result = oldValue+newValue;
          break;
        case "-=":
          result = oldValue-newValue;
          break;
        case "*=":
          result = oldValue*newValue;
          break;
        case "/=":
          if(newValue===0){
            throw new Error("Division durch null.");
          }
          result = oldValue/newValue;
          break;
        default:
          throw new Error("Unbekannter Zuweisungsoperator.");
      }

      setVariable(node.name,result);
      addOutput(node.name+" = "+roundNumber(result));
      return;
    }

    case "if":
      if(!node._compiledCondition){
        node._compiledCondition = compileCondition(node.condition);
      }

      if(evaluateCompiledCondition(node._compiledCondition)){
        await executeNodes(node.body);
      }else if(node.elseBody){
        await executeNodes(node.elseBody);
      }
      return;

    case "while":{
      if(!node._compiledCondition){
        node._compiledCondition = compileCondition(node.condition);
      }

      let iterations = 0;

      while(!stopped&&!breakRequested&&evaluateCompiledCondition(node._compiledCondition)){
        iterations++;
        loopDepth++;

        try{
          await executeNodes(node.body);
        }finally{
          loopDepth--;
        }

        if(stopped) return;

        if(breakRequested){
          breakRequested=false;
          return;
        }

        if(continueRequested){
          continueRequested=false;
          if(iterations%50===0) await fastYield();
          continue;
        }

        if(iterations%50===0){
          await fastYield();
        }
      }

      return;
    }

    case "command":
      await executeCommand(node);
      return;

    default:
      throw new Error("Unbekannter Programmteil.");
  }
}

async function executeCommand(node){
  const command = node.command;
  const args = node.args;

  switch(command){
    case "wait":{
      if(!node._compiledArgs) node._compiledArgs=[compileToken(args[0])];
      const duration = Number(resolveCompiledToken(node._compiledArgs[0]));

      if(!Number.isFinite(duration)||duration<0){
        throw new Error("wait benötigt eine positive Millisekunden-Zahl.");
      }

      let remaining = duration;

      while(remaining>0&&!stopped&&!breakRequested){
        const interval = Math.min(remaining,50);
        await new Promise(resolve=>setTimeout(resolve,interval));
        remaining -= interval;
      }

      return;
    }

    case "goto":
      if(!node._compiledArgs){
        node._compiledArgs = [compileToken(args[0]),compileToken(args[1])];
      }

      gotoPosition(
        resolveCompiledToken(node._compiledArgs[0]),
        resolveCompiledToken(node._compiledArgs[1])
      );
      addOutput("goto "+roundNumber(px)+","+roundNumber(py));
      return;

    case "color":
      if(!node._compiledArgs){
        node._compiledArgs = [compileToken(args[0])];
      }

      setPenColor(resolveCompiledToken(node._compiledArgs[0]));
      addOutput("pencolor "+penColor);
      return;

    case "thickness":
      if(!node._compiledArgs) node._compiledArgs=[compileToken(args[0])];
      setPenWidth(resolveCompiledToken(node._compiledArgs[0]));
      addOutput("thickness "+penWidth);
      return;

    case "penon":
      penIsOn = true;
      addOutput("penon");
      return;

    case "penoff":
      penIsOn = false;
      addOutput("penoff");
      return;

    case "clear":
      clearCanvas();
      px = 0;
      py = 0;
      updatePosition();
      addOutput("clear");
      return;

    case "cls":
      outputLines = [];
      shouldClearConsole = true;
      return;

    case "print":{
      const value=String(args[0]??"");
      if(node.literal){addOutput(value);return;}
      const simple=value.match(/^([a-z_$][a-z_$]*)$/i);
      if(simple){
        const key=simple[1].toLowerCase();
        if(key==="x"||key==="y"||Object.prototype.hasOwnProperty.call(variables,key)||functionScopes.some(scope=>Object.prototype.hasOwnProperty.call(scope,key))){
          const result=getVariable(key);
          addOutput(Array.isArray(result)?JSON.stringify(result):String(result));
        }else addOutput(value);
        return;
      }
      if(!/[+\-*/^()[\]]/.test(value)&&!/^[a-z_$][a-z_$]*\s*\(/i.test(value)){addOutput(value);return;}
      const result=resolveCompiledToken(compileToken(value));
      addOutput(Array.isArray(result)?JSON.stringify(result):String(result));
      return;
    }



    case "break":
      if(loopDepth===0) throw new Error("break kann nur innerhalb einer Schleife verwendet werden.");
      breakRequested=true;
      return;

    case "continue":
      if(loopDepth===0) throw new Error("continue kann nur innerhalb einer Schleife verwendet werden.");
      continueRequested=true;
      return;

    case "stop":
      stopped = true;
      addOutput("gestoppt");
      return;

    default:
      throw new Error("Unbekannter Befehl: "+command);
  }
}

function registerFunctionDefinitions(nodes){
  for(const node of nodes){
    if(!node) continue;
    if(node.type==="functionDef") functionDefinitions[node.name]=node;
    if(node.body) registerFunctionDefinitions(node.body);
    if(node.elseBody) registerFunctionDefinitions(node.elseBody);
  }
}

async function runProgram(source){
  if(running){
    addOutput("Es läuft bereits ein Programm.");
    return;
  }

  running = true;
  stopped = false;
  executionSteps = 0;
  outputLines = [];
  shouldClearConsole = false;
  breakRequested = false;
  continueRequested = false;
  loopDepth = 0;
  functionCallDepth = 0;
  functionScopes.length = 0;
  Object.keys(functionDefinitions).forEach(key=>delete functionDefinitions[key]);

  try{
    const parser = new ProgramParser(source);
    const program = parser.parse();
    registerFunctionDefinitions(program);
    await executeNodes(program);

    if(shouldClearConsole){
      writeConsole(outputLines.join("\n"));
    }else if(stopped){
      addOutput("Ausführung gestoppt.");
      writeConsole(outputLines.join("\n"));
    }else if(outputLines.length===0){
      writeConsole("fertig");
    }else{
      writeConsole(outputLines.join("\n"));
    }
  }catch(error){
    addOutput("Fehler: "+error.message);
    writeConsole(outputLines.join("\n"));
  }finally{
    running = false;
  }
}

function getCurrentLineInfo(){
  const cursor = editor.selectionStart;
  const value = editor.value;
  const lineStart = value.lastIndexOf("\n",cursor-1)+1;
  let lineEnd = value.indexOf("\n",cursor);

  if(lineEnd<0) lineEnd = value.length;

  return {
    value,
    cursor,
    lineStart,
    lineEnd,
    line:value.slice(lineStart,lineEnd),
    indent:(value.slice(lineStart,lineEnd).match(/^[ \t]*/) || [""])[0]
  };
}

function insertEditorText(text,cursorPosition){
  const start = editor.selectionStart;
  const end = editor.selectionEnd;
  const value = editor.value;

  editor.value = value.slice(0,start)+text+value.slice(end);
  editor.selectionStart = editor.selectionEnd =
    cursorPosition===undefined ? start+text.length : cursorPosition;
}

function findCondition(line){
  return /((?:else\s*)?if|elseif|while)\s*([a-z_$][a-z_$]*)\s*(==|!=|>=|<=|=|>|<)\s*([a-z_$][a-z_$]*|[-+]?(?:\d+(?:\.\d*)?|\.\d+))/i.exec(line);
}

function findIncompleteCondition(line){
  return /((?:else\s*)?if|elseif|while)\s*([a-z_$][a-z_$]*)\s*(==|!=|>=|<=|=|>|<)\s*$/i.exec(line);
}

function addMissingConditionDeclarations(line,conditionMatch){
  const info = getCurrentLineInfo();
  const sourceBeforeCondition =
    info.value.slice(0,info.lineStart+conditionMatch.index);
  const names = getDeclaredNames(sourceBeforeCondition);
  const missing = [];

  const left = conditionMatch[2].toLowerCase();
  const right = conditionMatch[4].toLowerCase();

  if(left!=="x"&&left!=="y"&&!isKeyPressName(left)&&!names.has(left)){
    missing.push(left);
    names.add(left);
  }

  if(/^[a-z_$][a-z_$]*$/i.test(right)&&
     right!=="x"&&right!=="y"&&!isKeyPressName(right)&&!names.has(right)){
    missing.push(right);
    names.add(right);
  }

  if(missing.length===0){
    return {line,inserted:0};
  }

  const insertion = missing.map(name=>name+"0").join("");
  const start = conditionMatch.index;

  return {
    line:line.slice(0,start)+insertion+line.slice(start),
    inserted:insertion.length
  };
}

function autoDeclareConditionVariable(){
  const info = getCurrentLineInfo();
  const beforeCursor = info.line.slice(0,info.cursor-info.lineStart);
  const condition = findIncompleteCondition(beforeCursor);

  if(!condition) return false;

  const variableName = condition[2].toLowerCase();
  if(variableName==="x"||variableName==="y"||isKeyPressName(variableName)) return false;

  const insertionAt = condition.index;
  const beforeKeyword =
    info.value.slice(0,info.lineStart+insertionAt);
  const names = getDeclaredNames(beforeKeyword);

  if(names.has(variableName)) return false;

  let absoluteInsertion = info.lineStart+insertionAt;

  if(/^(?:else\s*if|elseif)/i.test(condition[1])){
    const offset = condition[1].toLowerCase().lastIndexOf("if");
    absoluteInsertion += offset;
  }

  const insertion = variableName+"0";
  const oldCursor = editor.selectionStart;

  editor.value =
    info.value.slice(0,absoluteInsertion)+
    insertion+
    info.value.slice(absoluteInsertion);

  editor.selectionStart = editor.selectionEnd = oldCursor+insertion.length;
  return true;
}

function getEnclosingLoops(source,position){
  const stack = [];
  let segmentStart = 0;

  for(let i=0;i<position;i++){
    const character = source[i];

    if(character==="{"){
      const header = source.slice(segmentStart,i).trim();

      if(/^(?:true|while\s*.+)$/i.test(header)){
        const lineStart=source.lastIndexOf("\n",i-1)+1;
        const indent=(source.slice(lineStart,i).match(/^[ \t]*/) || [""])[0];
        stack.push({openIndex:i,indent});
      }else{
        stack.push(null);
      }

      segmentStart = i+1;
    }else if(character==="}"){
      stack.pop();
      segmentStart = i+1;
    }
  }

  return stack.filter(Boolean);
}

function getLoopDeclarationLine(source,loop){
  const start = loop.openIndex+1;
  let end = source.indexOf("\n",start);
  if(end<0) end=source.length;

  const line = source.slice(start,end);
  const match = line.match(/^([ \t]*)((?:[a-z_$]+0)+)(?=\s*(?:$|;))/i);

  if(!match) return null;

  return {
    start:start+match[1].length,
    end:start+match[1].length+match[2].length,
    indent:match[1],
    text:match[2],
    names:(match[2].match(/[a-z_$]+(?=0)/ig)||[]).map(name=>name.toLowerCase())
  };
}

function moveLoopVariableDeclaration(direction){
  const info = getCurrentLineInfo();
  const match = info.line.match(/^\s*([a-z_$][a-z_$]*)\s*(?:\+\+|--|\+=|-=|\*=|\/=|=)/i);

  if(!match) return false;

  const name = match[1].toLowerCase();
  if(name==="x"||name==="y"||isKeyPressName(name)) return false;

  const loops = getEnclosingLoops(info.value,info.lineStart);
  if(!loops.length) return false;

  const currentLoop = loops[loops.length-1];
  const parentLoop = loops.length>1?loops[loops.length-2]:null;
  const currentDeclaration = getLoopDeclarationLine(info.value,currentLoop);
  const parentDeclaration = parentLoop?getLoopDeclarationLine(info.value,parentLoop):null;

  let source = info.value;
  let from = null;
  let toLoop = null;

  if(direction==="up"){
    if(!parentLoop||!currentDeclaration||!currentDeclaration.names.includes(name)) return false;
    from=currentDeclaration;
    toLoop=parentLoop;
  }else{
    if(!parentLoop||!parentDeclaration||!parentDeclaration.names.includes(name)) return false;
    from=parentDeclaration;
    toLoop=currentLoop;
  }

  const targetDeclaration = getLoopDeclarationLine(source,toLoop);
  const targetHasName = targetDeclaration&&targetDeclaration.names.includes(name);

  if(targetHasName) return false;

  const remaining = from.names.filter(item=>item!==name);
  const replacement = remaining.length
    ? from.indent+remaining.map(item=>item+"0").join("")
    : "";

  source=source.slice(0,from.start-from.indent.length)+replacement+source.slice(from.end);

  const refreshedLoops=getEnclosingLoops(source,info.lineStart);
  const refreshedTarget=direction==="up"
    ? refreshedLoops[refreshedLoops.length-2]
    : refreshedLoops[refreshedLoops.length-1];

  if(!refreshedTarget) return false;

  const target=getLoopDeclarationLine(source,refreshedTarget);
  if(target){
    const names=target.names.concat([name]);
    const updated=target.indent+names.map(item=>item+"0").join("");
    source=source.slice(0,target.start-target.indent.length)+updated+source.slice(target.end);
  }else{
    const insertAt=refreshedTarget.openIndex+1;
    const declaration=refreshedTarget.indent+"\t"+name+"0";
    if(source[insertAt]==="\n"){
      source=source.slice(0,insertAt+1)+declaration+"\n"+source.slice(insertAt+1);
    }else{
      source=source.slice(0,insertAt)+"\n"+declaration+"\n"+source.slice(insertAt);
    }
  }

  const oldCursor=editor.selectionStart;
  editor.value=source;
  editor.selectionStart=editor.selectionEnd=oldCursor+(source.length-info.value.length);
  return true;
}

function findEnclosingLoop(source,position){
  const stack = [];
  let segmentStart = 0;

  for(let i=0;i<position;i++){
    const character = source[i];

    if(character==="{"){
      const header = source.slice(segmentStart,i).trim();
      const isLoop = /^(?:true|while\s*.+)$/i.test(header);
      const lineStart = source.lastIndexOf("\n",i-1)+1;
      const indent = (source.slice(lineStart,i).match(/^[ \t]*/) || [""])[0];

      stack.push({
        isLoop,
        openIndex:i,
        indent
      });

      segmentStart = i+1;
    }else if(character==="}"){
      stack.pop();
      segmentStart = i+1;
    }
  }

  for(let i=stack.length-1;i>=0;i--){
    if(stack[i].isLoop) return stack[i];
  }

  return null;
}

function autoDeclareLoopVariables(force=false){
  const info = getCurrentLineInfo();
  const beforeCursor = info.line.slice(0,info.cursor-info.lineStart);
  const afterCursor = info.value.slice(info.cursor);
  const loop = findEnclosingLoop(info.value,info.lineStart);

  if(!loop) return false;

  const statement = beforeCursor.trimStart();
  const completedStatement = statement.trimEnd();
  const boundary = afterCursor[0];
  const tokenFinished = force||statement.length>completedStatement.length||/[;,]/.test(statement)||/[ \t;]/.test(boundary||"");
  const names = [];
  let match = statement.match(
    /^([a-z_$][a-z_$]*)(\+\+|--|\+=|-=|\*=|\/=|=)([-+]?(?:\d+(?:\.\d*)?|\.\d+))?$/i
  );

  if(match){
    names.push(match[1]);
  }else{
    match = statement.match(
      /^(?:goto|move)\s*([a-z_$][a-z_$]*)(?=,|[ \t;]|$)/i
    );

    if(match){
      names.push(match[1]);
    }

    match = statement.match(
      /^([a-z_$][a-z_$]*)(\+\+|--|\+=|-=|\*=|\/=)\s*$/i
    );

    if(match) names.push(match[1]);
  }

  const assignmentRight = completedStatement.match(
    /^[a-z_$][a-z_$]*\s*(?:\+=|-=|\*=|\/=|=)\s*([a-z_$][a-z_$]*)$/i
  );

  if(assignmentRight&&tokenFinished){
    names.push(assignmentRight[1]);
  }

  if(!names.length) return false;

  const declared = getDeclaredNames(info.value.slice(0,info.lineStart));
  const missing = [...new Set(names.map(name=>name.toLowerCase()))].filter(name=>
    name!=="x"&&name!=="y"&&!isKeyPressName(name)&&!declared.has(name)
  );

  if(!missing.length) return false;

  const declaration = missing.map(name=>name+"0").join("");
  const newline = info.value.indexOf("\n",loop.openIndex);
  const insertionPoint = newline<0?loop.openIndex+1:newline+1;
  const insertion = newline<0
    ? "\n"+loop.indent+"\t"+declaration+"\n"+loop.indent+"\t"
    : loop.indent+"\t"+declaration+"\n";

  editor.value =
    info.value.slice(0,insertionPoint)+
    insertion+
    info.value.slice(insertionPoint);

  editor.selectionStart = editor.selectionEnd = info.cursor+insertion.length;
  return true;
}
function autoDeclareAssignmentVariable(){
  const info = getCurrentLineInfo();

  if(findEnclosingLoop(info.value,info.lineStart)) return false;

  const beforeCursor = info.line.slice(0,info.cursor-info.lineStart);

  if(findIncompleteCondition(beforeCursor)) return false;

  const match = beforeCursor.match(
    /^([ \t]*)([a-z_$][a-z_$]*)\s*(?:\+=|-=|\*=|\/=|=)\s*$/
  );

  if(!match) return false;

  const variableName = match[2].toLowerCase();
  if(variableName==="x"||variableName==="y"||isKeyPressName(variableName)) return false;

  const absoluteVariableStart = info.lineStart+match[1].length;
  const names = getDeclaredNames(
    info.value.slice(0,absoluteVariableStart)
  );

  if(names.has(variableName)) return false;

  const insertion = variableName+"0";

  editor.value =
    info.value.slice(0,absoluteVariableStart)+
    insertion+
    info.value.slice(absoluteVariableStart);

  const oldCursor = editor.selectionStart;
  editor.selectionStart = editor.selectionEnd = oldCursor+insertion.length;
  return true;
}

function autoOpenTrueLoopBlock(){
  const info = getCurrentLineInfo();
