function autoOpenBlockBeforeCommand(){
  const info = getCurrentLineInfo();

  const match = info.line.match(
    /((?:else\s*)?if|elseif|while)\s*([a-z_$][a-z_$]*)\s*(==|!=|>=|<=|=|>|<)\s*([-+]?(?:\d+(?:\.\d*)?|\.\d+))([a-z])$/i
  );

  if(!match) return;

  const line = info.line;
  const commandText = match[5];
  const conditionEnd =
    match.index+match[0].length-commandText.length;

  if(line.slice(conditionEnd).trimStart().startsWith("{")) return;

  const before = line.slice(0,conditionEnd);
  const newLine =
    before+" {\n"+info.indent+"\t"+
    commandText+"\n"+info.indent+"}";

  editor.value =
    info.value.slice(0,info.lineStart)+
    newLine+
    info.value.slice(info.lineEnd);

  const cursor =
    info.lineStart+before.length+4+info.indent.length+commandText.length;

  editor.selectionStart = editor.selectionEnd = cursor;
}

function completeBlockWithTab(){
  const info = getCurrentLineInfo();
  let line = info.line;
  let condition = findCondition(line);

  if(condition){
    const declarationResult =
      addMissingConditionDeclarations(line,condition);

    if(declarationResult.inserted){
      line = declarationResult.line;

      editor.value =
        info.value.slice(0,info.lineStart)+
        line+
        info.value.slice(info.lineEnd);

      editor.selectionStart = editor.selectionEnd =
        info.cursor+declarationResult.inserted;
    }
  }

  const refreshed = getCurrentLineInfo();
  line = refreshed.line;
  condition = findCondition(line);

  if(condition){
    const conditionEnd = condition.index+condition[0].length;
    const afterCondition = line.slice(conditionEnd);

    if(afterCondition.trimStart().startsWith("{")){
      const existingBrace = line.indexOf("{",conditionEnd);

      if(existingBrace>=0){
        editor.selectionStart = editor.selectionEnd =
          refreshed.lineStart+existingBrace+1;
      }

      return;
    }

    const before = line.slice(0,conditionEnd);
    const after = afterCondition.trimStart();
    const blockText =
      before+" {\n"+refreshed.indent+"\t"+
      after+"\n"+refreshed.indent+"}";

    editor.value =
      refreshed.value.slice(0,refreshed.lineStart)+
      blockText+
      refreshed.value.slice(refreshed.lineEnd);

    const bodyStart =
      refreshed.lineStart+before.length+3+refreshed.indent.length;

    editor.selectionStart = editor.selectionEnd =
      after.length===0 ? bodyStart : bodyStart+after.length;

    editor.focus();
    return;
  }

  if(/^\s*else\s*$/i.test(line)){
    const blockText =
      line+" {\n"+info.indent+"\t\n"+info.indent+"}";

    editor.value =
      info.value.slice(0,info.lineStart)+
      blockText+
      info.value.slice(info.lineEnd);

    const cursor =
      info.lineStart+line.length+3+info.indent.length;

    editor.selectionStart = editor.selectionEnd = cursor;
    editor.focus();
    return;
  }

  insertEditorText("\t");
}

editor.addEventListener("input",event=>{
  if(event.inputType==="insertText"&&event.data==="("){
    const cursor=editor.selectionStart;
    const value=editor.value;
    if(value[cursor]!==")") editor.value=value.slice(0,cursor)+")"+value.slice(cursor);
    editor.selectionStart=editor.selectionEnd=cursor;
  }
  if(autoDeclareLoopVariables()) return;

  const insertedCondition = autoDeclareConditionVariable();

  if(!insertedCondition){
    autoDeclareAssignmentVariable();
  }

  if(autoOpenTrueLoopBlock()) return;

  if(autoOpenBareConditionBlock()) return;

  autoOpenBlockBeforeCommand();
});

function normalizeKey(key){
  if(key==="ArrowUp") return "up";
  if(key==="ArrowDown") return "down";
  if(key==="ArrowLeft") return "left";
  if(key==="ArrowRight") return "right";
  if(key==="+") return "plus";
  if(key==="-") return "minus";
  if(key.length===1&&/^[a-z0-9]$/i.test(key)) return key.toLowerCase();
  return null;
}

document.addEventListener("keydown",event=>{
  const key = normalizeKey(event.key);
  if(key) pressedKeys.add(key);
});

document.addEventListener("keyup",event=>{
  const key = normalizeKey(event.key);
  if(key) pressedKeys.delete(key);
});

window.addEventListener("blur",()=>{
  pressedKeys.clear();
});

document.addEventListener("visibilitychange",()=>{
  if(document.hidden) pressedKeys.clear();
});

virtualKeyToggle.addEventListener("click",()=>{
  virtualKeyboard.hidden = !virtualKeyboard.hidden;
  virtualKeyToggle.setAttribute("aria-label",virtualKeyboard.hidden?"Tastatur einblenden":"Tastatur ausblenden");
  if(virtualKeyboard.hidden){
    virtualKeyboard.querySelectorAll("[data-key]").forEach(key=>{
      pressedKeys.delete(key.dataset.key);
      key.classList.remove("key-active");
    });
  }
});

virtualKeyboard.querySelectorAll("[data-key]").forEach(key=>{
  const press = event=>{
    event.preventDefault();
    const value = key.dataset.key;
    pressedKeys.add(value);
    key.classList.add("key-active");
    if(key.setPointerCapture&&event.pointerId!==undefined){
      key.setPointerCapture(event.pointerId);
    }
  };

  const release = event=>{
    if(event) event.preventDefault();
    pressedKeys.delete(key.dataset.key);
    key.classList.remove("key-active");
  };

  key.addEventListener("pointerdown",press);
  key.addEventListener("pointerup",release);
  key.addEventListener("pointercancel",release);
  key.addEventListener("lostpointercapture",release);
  key.addEventListener("contextmenu",event=>event.preventDefault());
});

editor.addEventListener("keydown",event=>{
  if(event.key==="ArrowUp"&&moveLoopVariableDeclaration("up")){
    event.preventDefault();
    return;
  }

  if(event.key==="ArrowDown"&&moveLoopVariableDeclaration("down")){
    event.preventDefault();
    return;
  }

  if(event.key==="Tab"){
    event.preventDefault();
    if(!autoDeclareLoopVariables(true)){
      completeBlockWithTab();
    }
    return;
  }

  if(event.key==="Enter"&&(event.ctrlKey||event.metaKey)){
    event.preventDefault();
    runProgram(editor.value);
    return;
  }

  if(event.key==="Enter"){
    event.preventDefault();
    const info = getCurrentLineInfo();
    const before = info.value.slice(0,info.cursor);
    let depth = 0;

    for(const character of before){
      if(character==="{") depth++;
      if(character==="}") depth=Math.max(0,depth-1);
    }

    const indent = "\t".repeat(depth);
    insertEditorText("\n"+indent,info.cursor+1+indent.length);
    editor.focus();
  }
});

runButton.addEventListener("click",()=>{
  runProgram(editor.value);
});

stopButton.addEventListener("click",()=>{
  stopped = true;
});

consoleButton.addEventListener("click",async()=>{
  try{
    await navigator.clipboard.writeText(consoleElement.textContent);
  }catch(error){
    const range = document.createRange();
    range.selectNodeContents(consoleElement);

    const selection = window.getSelection();
    selection.removeAllRanges();
    selection.addRange(range);
  }
});

codeButton.addEventListener("click",async()=>{
  try{
    await navigator.clipboard.writeText(editor.value);
  }catch(error){
    editor.focus();
    editor.select();
    document.execCommand("copy");
    editor.setSelectionRange(editor.value.length,editor.value.length);
  }
});

async function runConsoleCommand(){
  const command = consoleInput.value.trim();

  if(!command) return;

  consoleInput.value = "";

  if(/^cls$/i.test(command)){
    writeConsole("");
    return;
  }

  await runProgram(command);
}

enterButton.addEventListener("click",runConsoleCommand);

consoleInput.addEventListener("keydown",event=>{
  if(event.key==="Enter"){
    event.preventDefault();
    runConsoleCommand();
  }
});

editor.value = "";
clearCanvas();
updatePosition();
</script>
