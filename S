  if(!match) return false;

  const indent = match[1];
  const before = info.line;
  const blockText = before+" {\n"+indent+"\t\n"+indent+"}";

  editor.value =
    info.value.slice(0,info.lineStart)+
    blockText+
    info.value.slice(info.lineEnd);

  const cursor = info.lineStart+before.length+4+indent.length;
  editor.selectionStart = editor.selectionEnd = cursor;
