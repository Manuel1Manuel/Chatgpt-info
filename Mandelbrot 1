class CpuWorkerPool {
private:
    std::vector<std::thread> workers;
    std::mutex mutex;
    std::condition_variable wakeCondition;
    std::condition_variable doneCondition;
    std::atomic<int> nextRow{ 0 };
    std::atomic<bool> taskDone{ true };

    std::function<void(int)> currentTask;

    int endRow = 0;
    int pendingWorkers = 0;

    unsigned long long generation = 0;
    bool stopping = false;

    void workerLoop()
    {
        unsigned long long seenGeneration = 0;

        while (true)
        {
            std::function<void(int)> task;
            int localEndRow = 0;

            {
                std::unique_lock<std::mutex> lock(mutex);

                wakeCondition.wait(lock, [this, &seenGeneration]()
                {
                    return stopping || generation != seenGeneration;
                });

                if (stopping)
                    return;

                seenGeneration = generation;
                task = currentTask;
                localEndRow = endRow;
            }

            int row;

            while ((row = nextRow.fetch_add(1)) < localEndRow)
                task(row);

            {
                std::lock_guard<std::mutex> lock(mutex);

                pendingWorkers--;

                if (pendingWorkers == 0)
                {
                    currentTask = nullptr;
                    taskDone.store(true, std::memory_order_release);
                    doneCondition.notify_one();
                }
            }
        }
    }

public:
    CpuWorkerPool()
    {
        unsigned int count = std::thread::hardware_concurrency();

        if (count < 1)
            count = 1;

        if (count > 1)
            count--;

        if (count > 32)
            count = 32;

        workers.reserve(count);

        for (unsigned int i = 0; i < count; i++)
            workers.emplace_back(&CpuWorkerPool::workerLoop, this);
    }

    ~CpuWorkerPool()
    {
        {
            std::lock_guard<std::mutex> lock(mutex);
            stopping = true;
        }

        wakeCondition.notify_all();

        for (auto& worker : workers)
        {
            if (worker.joinable())
                worker.join();
        }
    }

    void dispatch(
        int startRow,
        int finishRow,
        std::function<void(int)> task
    )
    {
        if (startRow >= finishRow)
        {
            taskDone.store(true, std::memory_order_release);
            return;
        }

        {
            std::lock_guard<std::mutex> lock(mutex);

            currentTask = std::move(task);
            nextRow.store(startRow);
            endRow = finishRow;
            pendingWorkers = (int)workers.size();

            taskDone.store(false, std::memory_order_release);
            generation++;
        }

        wakeCondition.notify_all();
    }

    bool isDone() const
    {
        return taskDone.load(std::memory_order_acquire);
    }

    void wait()
    {
        std::unique_lock<std::mutex> lock(mutex);

        doneCondition.wait(lock, [this]()
        {
            return pendingWorkers == 0;
        });
    }
};

class ProcessCpuMeter {
private:
    bool initialized = false;
    ULONGLONG previousSystemTime = 0;
    ULONGLONG previousProcessTime = 0;

    ULONGLONG fileTimeValue(FILETIME value)
    {
        ULARGE_INTEGER result;
        result.LowPart = value.dwLowDateTime;
        result.HighPart = value.dwHighDateTime;
        return result.QuadPart;
    }

public:
    int sample()
    {
        FILETIME idleTime = {};
        FILETIME kernelTime = {};
        FILETIME userTime = {};

        FILETIME creationTime = {};
        FILETIME exitTime = {};
        FILETIME processKernelTime = {};
        FILETIME processUserTime = {};

        if (!GetSystemTimes(&idleTime, &kernelTime, &userTime))
            return -1;

        if (!GetProcessTimes(
            GetCurrentProcess(),
            &creationTime,
            &exitTime,
            &processKernelTime,
            &processUserTime))
            return -1;

        ULONGLONG systemTime =
            fileTimeValue(kernelTime) +
            fileTimeValue(userTime);

        ULONGLONG processTime =
            fileTimeValue(processKernelTime) +
            fileTimeValue(processUserTime);

        if (!initialized)
        {
            previousSystemTime = systemTime;
            previousProcessTime = processTime;
            initialized = true;
            return -1;
        }

        ULONGLONG systemDifference =
            systemTime - previousSystemTime;

        ULONGLONG processDifference =
            processTime - previousProcessTime;

        previousSystemTime = systemTime;
        previousProcessTime = processTime;

        if (systemDifference == 0)
            return -1;

        int usage = (int)std::lround(
            100.0 * (double)processDifference / (double)systemDifference
        );

        if (usage < 0)
            usage = 0;

        if (usage > 100)
            usage = 100;

        return usage;
    }
};

__host__ __device__ inline DoubleDouble ddFromDouble(double value)
{
    return { value, 0.0 };
}

__host__ __device__ inline DoubleDouble ddNormalize(double high, double low)
{
    double sum = high + low;
    double error = low - (sum - high);

    return { sum, error };
}

__host__ __device__ inline DoubleDouble ddAdd(
    DoubleDouble a,
    DoubleDouble b
)
{
    double sum = a.hi + b.hi;
    double virtualB = sum - a.hi;

    double error =
        (a.hi - (sum - virtualB)) +
        (b.hi - virtualB) +
        a.lo +
        b.lo;

    return ddNormalize(sum, error);
}

__host__ __device__ inline DoubleDouble ddSub(
    DoubleDouble a,
    DoubleDouble b
)
{
    DoubleDouble negative = { -b.hi, -b.lo };
    return ddAdd(a, negative);
}

__host__ __device__ inline double ddFma(
    double a,
    double b,
    double c
)
{
#ifdef __CUDA_ARCH__
    return __fma_rn(a, b, c);
#else
    return std::fma(a, b, c);
#endif
}

__host__ __device__ inline DoubleDouble ddMul(
    DoubleDouble a,
    DoubleDouble b
)
{
    double product = a.hi * b.hi;

    double error = ddFma(a.hi, b.hi, -product);
    error += a.hi * b.lo;
    error += a.lo * b.hi;
    error += a.lo * b.lo;

    return ddNormalize(product, error);
}

__host__ __device__ inline int ddCompare(
    DoubleDouble a,
    DoubleDouble b
)
{
    if (a.hi < b.hi)
        return -1;

    if (a.hi > b.hi)
        return 1;

    if (a.lo < b.lo)
        return -1;

    if (a.lo > b.lo)
        return 1;

    return 0;
}

__host__ __device__ inline double ddToDouble(DoubleDouble value)
{
    return value.hi + value.lo;
}

bool checkCuda(cudaError_t error)
{
    if (error != cudaSuccess)
    {
        char message[512];
        sprintf_s(message, "CUDA-Fehler:\n%s", cudaGetErrorString(error));
        MessageBoxA(nullptr, message, "CUDA-Fehler", MB_ICONERROR);
        return false;
    }

    return true;
}

void initializeNvml()
{
    nvmlLibrary = LoadLibraryA("nvml.dll");

    if (!nvmlLibrary)
    {
        char systemPath[MAX_PATH];
        GetSystemDirectoryA(systemPath, MAX_PATH);
        strcat_s(systemPath, "\\nvml.dll");
        nvmlLibrary = LoadLibraryA(systemPath);
    }

    if (!nvmlLibrary)
        return;

    nvmlInitFunction =
        (NvmlInit)GetProcAddress(nvmlLibrary, "nvmlInit_v2");

    nvmlGetDeviceFunction =
        (NvmlGetDevice)GetProcAddress(
            nvmlLibrary,
            "nvmlDeviceGetHandleByIndex_v2"
        );

    nvmlGetUtilizationFunction =
        (NvmlGetUtilization)GetProcAddress(
            nvmlLibrary,
            "nvmlDeviceGetUtilizationRates"
        );

    nvmlShutdownFunction =
        (NvmlShutdown)GetProcAddress(nvmlLibrary, "nvmlShutdown");

    if (!nvmlInitFunction ||
        !nvmlGetDeviceFunction ||
        !nvmlGetUtilizationFunction)
        return;

    if (nvmlInitFunction() != 0)
        return;

    if (nvmlGetDeviceFunction(0, &nvmlDevice) != 0)
    {
        if (nvmlShutdownFunction)
            nvmlShutdownFunction();

        return;
    }

    nvmlAvailable = true;
}

int getGpuUsage()
{
    if (!nvmlAvailable)
        return -1;

    NvmlUtilization utilization = {};

    if (nvmlGetUtilizationFunction(nvmlDevice, &utilization) != 0)
        return -1;

    return (int)utilization.gpu;
}

__host__ __device__ uchar4 computeMandelbrotPixelDouble(
    int x,
    int y,
    int width,
    int height,
    double cx,
    double cy,
    double zoomValue,
    int iterations
)
{
    int smallerDimension = width < height ? width : height;

    double scale =
        3.5 / ((double)smallerDimension * zoomValue);

    double cr =
        cx + ((double)x - width * 0.5) * scale;

    double ci =
        cy + (height * 0.5 - (double)y) * scale;

    double q =
        (cr - 0.25) * (cr - 0.25) + ci * ci;

    if (q * (q + cr - 0.25) <= 0.25 * ci * ci ||
        (cr + 1.0) * (cr + 1.0) + ci * ci <= 0.0625)
    {
        return make_uchar4(0, 0, 0, 255);
    }

    double zx = 0.0;
    double zy = 0.0;
    double magnitude = 0.0;

    int iteration = 0;

    while (magnitude <= 256.0 && iteration < iterations)
    {
        double nextX = zx * zx - zy * zy + cr;
        zy = 2.0 * zx * zy + ci;
        zx = nextX;

        magnitude = zx * zx + zy * zy;
        iteration++;
    }

    if (iteration >= iterations)
        return make_uchar4(0, 0, 0, 255);

    double smooth =
        iteration + 1.0 - log2(log2(sqrt(magnitude)));

    double t = smooth * 0.035;

    unsigned char r =
        (unsigned char)(127.5 + 127.5 * cos(t));

    unsigned char g =
        (unsigned char)(127.5 + 127.5 * cos(t + 2.094395102));

    unsigned char b =
        (unsigned char)(127.5 + 127.5 * cos(t + 4.188790205));

    return make_uchar4(b, g, r, 255);
}

__host__ __device__ uchar4 computeMandelbrotPixelDeep(
    int x,
    int y,
    int width,
    int height,
    DoubleDouble cx,
    DoubleDouble cy,
    double zoomValue,
    int iterations
)
{
    int smallerDimension = width < height ? width : height;

    double scale =
        3.5 / ((double)smallerDimension * zoomValue);

    double offsetX =
        ((double)x - width * 0.5) * scale;

    double offsetY =
        (height * 0.5 - (double)y) * scale;

    DoubleDouble cr =
        ddAdd(cx, ddFromDouble(offsetX));

    DoubleDouble ci =
        ddAdd(cy, ddFromDouble(offsetY));

    DoubleDouble quarter = ddFromDouble(0.25);
    DoubleDouble halfSquared = ddFromDouble(0.0625);
    DoubleDouble bailout = ddFromDouble(256.0);

    DoubleDouble xMinusQuarter =
        ddSub(cr, quarter);

    DoubleDouble ciSquared =
        ddMul(ci, ci);

    DoubleDouble q = ddAdd(
        ddMul(xMinusQuarter, xMinusQuarter),
        ciSquared
    );

    DoubleDouble cardioidLeft =
        ddMul(q, ddAdd(q, xMinusQuarter));

    DoubleDouble cardioidRight =
        ddMul(quarter, ciSquared);

    if (ddCompare(cardioidLeft, cardioidRight) <= 0)
        return make_uchar4(0, 0, 0, 255);

    DoubleDouble bulbX =
        ddAdd(cr, ddFromDouble(1.0));

    DoubleDouble bulbValue = ddAdd(
        ddMul(bulbX, bulbX),
        ciSquared
    );

    if (ddCompare(bulbValue, halfSquared) <= 0)
        return make_uchar4(0, 0, 0, 255);

    DoubleDouble zx = ddFromDouble(0.0);
    DoubleDouble zy = ddFromDouble(0.0);
    DoubleDouble magnitude = ddFromDouble(0.0);

    int iteration = 0;

    while (ddCompare(magnitude, bailout) <= 0 &&
        iteration < iterations)
    {
        DoubleDouble zxSquared = ddMul(zx, zx);
        DoubleDouble zySquared = ddMul(zy, zy);
        DoubleDouble zxzy = ddMul(zx, zy);

        DoubleDouble nextX = ddAdd(
            ddSub(zxSquared, zySquared),
            cr
        );

        DoubleDouble nextY = ddAdd(
            ddMul(ddFromDouble(2.0), zxzy),
            ci
        );

        zx = nextX;
        zy = nextY;

        magnitude = ddAdd(
            ddMul(zx, zx),
            ddMul(zy, zy)
        );

        iteration++;
    }

    if (iteration >= iterations)
        return make_uchar4(0, 0, 0, 255);

    double magnitudeValue = ddToDouble(magnitude);

    double smooth =
        iteration + 1.0 -
        log2(log2(sqrt(magnitudeValue)));

    double t = smooth * 0.035;

    unsigned char r =
        (unsigned char)(127.5 + 127.5 * cos(t));

    unsigned char g =
        (unsigned char)(127.5 + 127.5 * cos(t + 2.094395102));

    unsigned char b =
        (unsigned char)(127.5 + 127.5 * cos(t + 4.188790205));

    return make_uchar4(b, g, r, 255);
}

__host__ __device__ uchar4 computeMandelbrotPixel(
    int x,
    int y,
    int width,
    int height,
    DoubleDouble cx,
    DoubleDouble cy,
    double zoomValue,
    int iterations,
    bool highPrecision
)
{
    if (highPrecision)
    {
        return computeMandelbrotPixelDeep(
            x,
            y,
            width,
            height,
            cx,
            cy,
            zoomValue,
            iterations
        );
    }

    return computeMandelbrotPixelDouble(
        x,
        y,
        width,
        height,
        ddToDouble(cx),
        ddToDouble(cy),
        zoomValue,
        iterations
    );
}

__host__ __device__ void renderMandelbrotBlock(
    uchar4* pixels,
    int width,
    int height,
    int blockSize,
    int blockX,
    int blockY,
    DoubleDouble cx,
    DoubleDouble cy,
    double zoomValue,
    int iterations,
    bool highPrecision
)
{
    int startX = blockX * blockSize;
    int startY = blockY * blockSize;

    int endX = startX + blockSize;
    int endY = startY + blockSize;

    if (endX > width)
        endX = width;

    if (endY > height)
        endY = height;

    if (startX >= width || startY >= height)
        return;

    int sampleX = (startX + endX - 1) / 2;
    int sampleY = (startY + endY - 1) / 2;

    uchar4 color = computeMandelbrotPixel(
        sampleX,
        sampleY,
        width,
        height,
        cx,
        cy,
        zoomValue,
        iterations,
        highPrecision
    );

    for (int y = startY; y < endY; y++)
    {
        for (int x = startX; x < endX; x++)
            pixels[y * width + x] = color;
    }
}

__global__ void mandelbrotKernel(
    uchar4* pixels,
    int width,
    int height,
    int blockSize,
    int blockColumns,
    int firstBlockRow,
    int blockRowCount,
    DoubleDouble cx,
    DoubleDouble cy,
    double zoomValue,
    int iterations,
    bool highPrecision
)
{
    int blockX =
        blockIdx.x * blockDim.x + threadIdx.x;

    int localBlockY =
        blockIdx.y * blockDim.y + threadIdx.y;

    if (blockX >= blockColumns ||
        localBlockY >= blockRowCount)
        return;

    int blockY = firstBlockRow + localBlockY;

    renderMandelbrotBlock(
        pixels,
        width,
        height,
        blockSize,
        blockX,
        blockY,
        cx,
        cy,
        zoomValue,
        iterations,
        highPrecision
    );
}

void renderCpuBlockRow(
    uchar4* pixels,
    const RenderConfig& config,
    int blockRow
)
{
    for (int blockX = 0;
        blockX < config.blockColumns;
        blockX++)
    {
        renderMandelbrotBlock(
            pixels,
            config.width,
            config.height,
            config.blockSize,
            blockX,
            blockRow,
            config.cx,
            config.cy,
            config.zoomValue,
            config.iterations,
            config.highPrecision
        );
    }
}

RenderConfig makeRenderConfig(int cpuShare)
{
    RenderConfig config = {};

    RECT rect;
    GetClientRect(windowHandle, &rect);

    config.clientWidth = rect.right;
    config.clientHeight = rect.bottom;

    config.imageTop = isFullscreen ? 0 : IMAGE_TOP;

    int controlHeight =
        isFullscreen ? 0 : CONTROL_AREA_HEIGHT;

    config.areaHeight =
        config.clientHeight - config.imageTop - controlHeight;

    if (config.areaHeight < 1)
        config.areaHeight = 1;

    if (config.clientWidth < 1)
        config.clientWidth = 1;

    config.width = config.clientWidth;
    config.height = config.areaHeight;

    double sizeLimit = 1.0;

    if (config.width > MAX_WIDTH)
    {
        double limit =
            (double)MAX_WIDTH / config.width;

        if (limit < sizeLimit)
            sizeLimit = limit;
    }

    if (config.height > MAX_HEIGHT)
    {
        double limit =
            (double)MAX_HEIGHT / config.height;

        if (limit < sizeLimit)
            sizeLimit = limit;
    }

    if (sizeLimit < 1.0)
    {
        config.width =
            (int)std::floor(config.width * sizeLimit);

        config.height =
            (int)std::floor(config.height * sizeLimit);
    }

    if (config.width < 1)
        config.width = 1;

    if (config.height < 1)
        config.height = 1;

    config.blockSize = resolutionBlockSize;

    if (config.blockSize < 1)
        config.blockSize = 1;

    if (config.blockSize > 16)
        config.blockSize = 16;

    config.blockColumns =
        (config.width + config.blockSize - 1) /
        config.blockSize;

    config.totalBlockRows =
        (config.height + config.blockSize - 1) /
        config.blockSize;

    if (cpuShare < 0)
        cpuShare = 0;

    if (cpuShare > 100)
        cpuShare = 100;

    int gpuShare = 100 - cpuShare;

    config.gpuBlockRows = (int)std::lround(
        config.totalBlockRows * (gpuShare / 100.0)
    );

    if (cpuShare == 0)
        config.gpuBlockRows = config.totalBlockRows;

    if (cpuShare == 100)
        config.gpuBlockRows = 0;

    if (cpuShare > 0 &&
        cpuShare < 100 &&
        config.totalBlockRows >= 2)
    {
        if (config.gpuBlockRows < 1)
            config.gpuBlockRows = 1;

        if (config.gpuBlockRows >= config.totalBlockRows)
            config.gpuBlockRows = config.totalBlockRows - 1;
    }

    if (config.gpuBlockRows < 0)
        config.gpuBlockRows = 0;

    if (config.gpuBlockRows > config.totalBlockRows)
        config.gpuBlockRows = config.totalBlockRows;

    config.cpuStartBlockRow = config.gpuBlockRows;

    config.cpuBlockRows =
        config.totalBlockRows - config.gpuBlockRows;

    config.gpuPixelRows =
        config.gpuBlockRows * config.blockSize;

    if (config.gpuPixelRows > config.height)
        config.gpuPixelRows = config.height;

    config.cpuPixelStart = config.gpuPixelRows;
    config.cpuPixelEnd = config.height;

    config.iterations = maxIterations;
    config.zoomValue = zoom;

    config.cx = centerX;
    config.cy = centerY;

    config.highPrecision =
        zoom >= DEEP_ZOOM_THRESHOLD;

    return config;
}

bool sameLayout(
    const RenderConfig& a,
    const RenderConfig& b
)
{
    return
        a.width == b.width &&
        a.height == b.height &&
        a.clientWidth == b.clientWidth &&
        a.clientHeight == b.clientHeight &&
        a.imageTop == b.imageTop &&
        a.areaHeight == b.areaHeight &&
        a.blockSize == b.blockSize &&
        a.gpuBlockRows == b.gpuBlockRows;
}

RenderConfig activeLayoutConfig = {};
bool activeLayoutValid = false;

void applyLayout(const RenderConfig& config)
{
    bool dimensionsChanged =
        !displayImageAvailable ||
        displayWidth != config.width ||
        displayHeight != config.height;

    displayWidth = config.width;
    displayHeight = config.height;
    displayImageAvailable = true;

    if (dimensionsChanged)
    {
        size_t pixels =
            (size_t)config.width * config.height;

        std::fill(
            displayPixels.begin(),
            displayPixels.begin() + pixels,
            make_uchar4(0, 0, 0, 255)
        );
    }

    activeLayoutConfig = config;
    activeLayoutValid = true;

    RECT updateRect = {
        0,
        config.imageTop,
        config.clientWidth,
        config.imageTop + config.areaHeight
    };

    InvalidateRect(windowHandle, &updateRect, FALSE);
}

bool layoutMatchesActive(const RenderConfig& config)
{
    return activeLayoutValid &&
        sameLayout(config, activeLayoutConfig);
}

void publishRegion(
    const uchar4* source,
    int startRow,
    int endRow,
    const RenderConfig& config
)
{
    if (startRow >= endRow)
        return;

    if (!IsWindow(windowHandle))
        return;

    if (!displayImageAvailable ||
        config.width != displayWidth ||
        config.height != displayHeight)
        return;

    size_t rowBytes =
        (size_t)config.width * sizeof(uchar4);

    size_t copyBytes =
        (size_t)(endRow - startRow) * rowBytes;

    memcpy(
        displayPixels.data() +
            (size_t)startRow * config.width,
        source +
            (size_t)startRow * config.width,
        copyBytes
    );

    int destinationTop =
        config.imageTop +
        MulDiv(startRow, config.areaHeight, config.height);

    int destinationBottom =
        config.imageTop +
        MulDiv(endRow, config.areaHeight, config.height);

    if (destinationBottom <= destinationTop)
        destinationBottom = destinationTop + 1;

    RECT updateRect = {
        0,
        destinationTop,
        config.clientWidth,
        destinationBottom
    };

    InvalidateRect(windowHandle, &updateRect, FALSE);
}

void publishFullFrame(const RenderConfig& config)
{
    if (!IsWindow(windowHandle))
        return;

    if (!displayImageAvailable ||
        config.width != displayWidth ||
        config.height != displayHeight)
        return;

    if (config.gpuPixelRows > 0)
    {
        size_t bytes =
            (size_t)config.gpuPixelRows *
            config.width *
            sizeof(uchar4);

        memcpy(
            displayPixels.data(),
            gpuHostPixels,
            bytes
        );
    }

    if (config.cpuPixelStart < config.cpuPixelEnd)
    {
        size_t rows =
            config.cpuPixelEnd - config.cpuPixelStart;

        size_t bytes =
            rows * config.width * sizeof(uchar4);

        memcpy(
            displayPixels.data() +
                (size_t)config.cpuPixelStart * config.width,
            cpuPixels.data() +
                (size_t)config.cpuPixelStart * config.width,
            bytes
        );
    }

    RECT updateRect = {
        0,
        config.imageTop,
        config.clientWidth,
        config.imageTop + config.areaHeight
    };

    InvalidateRect(windowHandle, &updateRect, FALSE);
}

void requestCpuShare(int value)
{
    if (value < 0)
        value = 0;

    if (value > 100)
        value = 100;

    pendingCpuShare = value;
    shareChangePending = pendingCpuShare != appliedCpuShare;

    cpuShareSliderData.value = value;

    if (cpuShareSlider)
        InvalidateRect(cpuShareSlider, nullptr, FALSE);
}

void recordCpuRate(int rows, double milliseconds)
{
    if (rows <= 0 || milliseconds <= 0.01)
        return;

    double measuredRate = rows / milliseconds;

    if (!cpuRateInitialized)
    {
        cpuRowsPerMs = measuredRate;
        cpuRateInitialized = true;
    }
    else
    {
        cpuRowsPerMs =
            cpuRowsPerMs * 0.8 +
            measuredRate * 0.2;
    }

    cpuRateVersion++;
}

void recordGpuRate(int rows, double milliseconds)
{
    if (rows <= 0 || milliseconds <= 0.01)
        return;

    double measuredRate = rows / milliseconds;

    if (!gpuRateInitialized)
    {
        gpuRowsPerMs = measuredRate;
        gpuRateInitialized = true;
    }
    else
    {
        gpuRowsPerMs =
            gpuRowsPerMs * 0.8 +
            measuredRate * 0.2;
    }

    gpuRateVersion++;
}

void updateAutomaticBalance()
{
    if (!autoBalanceEnabled)
        return;

    if (!cpuRateInitialized ||
        !gpuRateInitialized)
        return;

    if (cpuRateVersion == lastAutoCpuVersion ||
        gpuRateVersion == lastAutoGpuVersion)
        return;

    lastAutoCpuVersion = cpuRateVersion;
    lastAutoGpuVersion = gpuRateVersion;

    double totalRate =
        cpuRowsPerMs + gpuRowsPerMs;

    if (totalRate <= 0.0)
        return;

    double idealCpuShare =
        100.0 * cpuRowsPerMs / totalRate;

    if (idealCpuShare < 1.0)
        idealCpuShare = 1.0;

    if (idealCpuShare > 99.0)
        idealCpuShare = 99.0;

    double adjustedShare =
        appliedCpuShare +
        (idealCpuShare - appliedCpuShare) * 0.25;

    int newShare =
        (int)std::lround(adjustedShare);

    if (newShare < 1)
        newShare = 1;

    if (newShare > 99)
        newShare = 99;

    if (abs(newShare - appliedCpuShare) >= 1)
        requestCpuShare(newShare);
}

