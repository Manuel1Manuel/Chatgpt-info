    }

    SendMessageA(gpuShareLabel, WM_SETFONT, (WPARAM)uiFont, TRUE);
    SendMessageA(cpuShareLabel, WM_SETFONT, (WPARAM)uiFont, TRUE);
    SendMessageA(statusLabel, WM_SETFONT, (WPARAM)statusFont, TRUE);
    SendMessageA(iterationLabel, WM_SETFONT, (WPARAM)uiFont, TRUE);
    SendMessageA(resolutionLabel, WM_SETFONT, (WPARAM)uiFont, TRUE);
    SendMessageA(autoButton, WM_SETFONT, (WPARAM)uiFont, TRUE);
    SendMessageA(partialButton, WM_SETFONT, (WPARAM)uiFont, TRUE);

    updateLabels();
    layoutControls(windowHandle);

    ShowWindow(windowHandle, SW_SHOWMAXIMIZED);
    UpdateWindow(windowHandle);

    bitmapInfo.bmiHeader.biSize =
        sizeof(BITMAPINFOHEADER);

    bitmapInfo.bmiHeader.biPlanes = 1;
    bitmapInfo.bmiHeader.biBitCount = 32;
    bitmapInfo.bmiHeader.biCompression = BI_RGB;

    CpuWorkerPool cpuPool;
    globalCpuPool = &cpuPool;

    ProcessCpuMeter cpuMeter;

    applyLayout(makeRenderConfig(appliedCpuShare));

    MSG message = {};

    auto previousTime =
        std::chrono::steady_clock::now();

    auto previousStatusTime = previousTime;

    bool running = true;
    bool cudaFailure = false;

    while (running)
    {
        while (PeekMessageA(
            &message,
            nullptr,
            0,
            0,
            PM_REMOVE))
        {
            if (message.message == WM_QUIT)
            {
                running = false;
                break;
            }

            TranslateMessage(&message);
            DispatchMessageA(&message);
        }

        if (!running)
            break;

        if (IsIconic(windowHandle))
        {
            panVelocityX = 0.0;
            panVelocityY = 0.0;
            zoomVelocity = 0.0;

            fKeyWasDown = false;
            escKeyWasDown = false;

            Sleep(30);
            continue;
        }

        auto currentTime =
            std::chrono::steady_clock::now();

        double deltaTime =
            std::chrono::duration<double>(
                currentTime - previousTime
            ).count();

        previousTime = currentTime;

        if (deltaTime > 0.05)
            deltaTime = 0.05;

        if (deltaTime < 0.0)
            deltaTime = 0.0;

        bool windowActive =
            GetForegroundWindow() == windowHandle;

        bool fKeyIsDown =
            windowActive &&
            (GetAsyncKeyState('F') & 0x8000) != 0;

        if (fKeyIsDown && !fKeyWasDown)
            toggleFullscreen();

        fKeyWasDown = fKeyIsDown;

        bool escKeyIsDown =
            windowActive &&
            (GetAsyncKeyState(VK_ESCAPE) & 0x8000) != 0;

        if (escKeyIsDown &&
            !escKeyWasDown &&
            isFullscreen)
        {
            exitFullscreen();
        }

        escKeyWasDown = escKeyIsDown;

        updateCamera(deltaTime, windowActive);

        if (cpuBusy && cpuPool.isDone())
            finishCpuJob();

        if (gpuBusy)
        {
            if (!finishGpuJob())
            {
                cudaFailure = true;
                running = false;
                break;
            }
        }

        finishSynchronousFrame();

        RenderConfig currentConfig =
            makeRenderConfig(
                shareChangePending
                    ? pendingCpuShare
                    : appliedCpuShare
            );

        if (!cpuBusy &&
            !gpuBusy &&
            !syncFrameActive &&
            shareChangePending)
        {
            appliedCpuShare = pendingCpuShare;
            shareChangePending = false;

            cpuShareSliderData.value = appliedCpuShare;

            currentConfig =
                makeRenderConfig(appliedCpuShare);
        }

        if (!partialUpdatesEnabled)
        {
            if (!syncFrameActive &&
                !cpuBusy &&
                !gpuBusy)
            {
                currentConfig =
                    makeRenderConfig(appliedCpuShare);

                if (!layoutMatchesActive(currentConfig))
                    applyLayout(currentConfig);

                startSynchronousFrame(
                    cpuPool,
                    currentConfig
                );
            }
        }
        else
        {
            if (!syncFrameActive &&
                !cpuBusy &&
                !gpuBusy)
            {
                currentConfig =
                    makeRenderConfig(appliedCpuShare);

                if (!layoutMatchesActive(currentConfig))
                    applyLayout(currentConfig);
            }

            if (!syncFrameActive &&
                !shareChangePending &&
                layoutMatchesActive(
                    makeRenderConfig(appliedCpuShare)
                ))
            {
                currentConfig =
                    makeRenderConfig(appliedCpuShare);

                if (!cpuBusy &&
                    currentConfig.cpuBlockRows > 0)
                {
                    if (!startCpuJob(
                        cpuPool,
                        currentConfig,
                        true))
                    {
                        running = false;
                        break;
                    }
                }

                if (!gpuBusy &&
                    currentConfig.gpuBlockRows > 0)
                {
                    if (!startGpuJob(
                        currentConfig,
                        true))
                    {
                        cudaFailure = true;
                        running = false;
                        break;
                    }
                }
            }
        }

        if (!isFullscreen &&
            std::chrono::duration<double>(
                currentTime - previousStatusTime
            ).count() >= 0.5)
        {
            currentGpuUsage = getGpuUsage();
            currentCpuUsage = cpuMeter.sample();

            updateShareLabels();

            char status[512];

            if (zoom >= DEEP_ZOOM_THRESHOLD)
            {
                sprintf_s(
                    status,
                    "Zoom: %.3e | %s | Double-Double | CUDA",
                    zoom,
                    deviceProperties.name
                );
            }
            else
            {
                sprintf_s(
                    status,
                    "Zoom: %.2fx | %s | CUDA",
                    zoom,
                    deviceProperties.name
                );
            }

            SetWindowTextA(statusLabel, status);

            previousStatusTime = currentTime;
        }

        Sleep(1);
    }

    if (cpuBusy)
        cpuPool.wait();

    if (gpuBusy)
        cudaStreamSynchronize(renderStream);

    if (nvmlAvailable && nvmlShutdownFunction)
        nvmlShutdownFunction();

    if (nvmlLibrary)
        FreeLibrary(nvmlLibrary);

    if (uiFont)
        DeleteObject(uiFont);

    if (statusFont)
        DeleteObject(statusFont);

    cudaEventDestroy(gpuDoneEvent);
    cudaStreamDestroy(renderStream);

    cudaFree(devicePixels);
    cudaFreeHost(gpuHostPixels);

    globalCpuPool = nullptr;

    return cudaFailure ? 1 : 0;
}
