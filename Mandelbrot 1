void enterFullscreen()
{
    if (isFullscreen)
        return;

    windowedStyle =
        GetWindowLongPtrA(windowHandle, GWL_STYLE);

    windowedExStyle =
        GetWindowLongPtrA(windowHandle, GWL_EXSTYLE);

    windowedPlacement.length =
        sizeof(WINDOWPLACEMENT);

    GetWindowPlacement(
        windowHandle,
        &windowedPlacement
    );

    HMONITOR monitor = MonitorFromWindow(
        windowHandle,
        MONITOR_DEFAULTTONEAREST
    );

    MONITORINFO monitorInfo = {};
    monitorInfo.cbSize = sizeof(MONITORINFO);

    if (!GetMonitorInfoA(monitor, &monitorInfo))
        return;

    LONG_PTR newStyle = windowedStyle;

    newStyle &= ~(
        WS_CAPTION |
        WS_THICKFRAME |
        WS_MINIMIZE |
        WS_MAXIMIZE |
        WS_SYSMENU
    );

    newStyle |= WS_POPUP | WS_VISIBLE;

    LONG_PTR newExStyle = windowedExStyle;

    newExStyle &= ~(
        WS_EX_DLGMODALFRAME |
        WS_EX_WINDOWEDGE |
        WS_EX_CLIENTEDGE |
        WS_EX_STATICEDGE
    );

    SetWindowLongPtrA(
        windowHandle,
        GWL_STYLE,
        newStyle
    );

    SetWindowLongPtrA(
        windowHandle,
        GWL_EXSTYLE,
        newExStyle
    );

    SetWindowPos(
        windowHandle,
        HWND_TOP,
        monitorInfo.rcMonitor.left,
        monitorInfo.rcMonitor.top,
        monitorInfo.rcMonitor.right - monitorInfo.rcMonitor.left,
        monitorInfo.rcMonitor.bottom - monitorInfo.rcMonitor.top,
        SWP_NOZORDER |
        SWP_NOACTIVATE |
        SWP_FRAMECHANGED
    );

    ShowWindow(gpuShareLabel, SW_HIDE);
    ShowWindow(cpuShareLabel, SW_HIDE);
    ShowWindow(cpuShareSlider, SW_HIDE);
    ShowWindow(statusLabel, SW_HIDE);
    ShowWindow(iterationLabel, SW_HIDE);
    ShowWindow(resolutionLabel, SW_HIDE);
    ShowWindow(iterationSlider, SW_HIDE);
    ShowWindow(resolutionSlider, SW_HIDE);
    ShowWindow(autoButton, SW_HIDE);
    ShowWindow(partialButton, SW_HIDE);

    isFullscreen = true;

    InvalidateRect(windowHandle, nullptr, FALSE);
}

void exitFullscreen()
{
