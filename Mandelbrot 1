void updateCamera(double deltaTime, bool windowActive)
{
    if (!windowActive)
    {
        panVelocityX = 0.0;
        panVelocityY = 0.0;
        zoomVelocity = 0.0;
        return;
    }

    double zoomInput = 0.0;

    if (GetAsyncKeyState(VK_UP) & 0x8000)
        zoomInput += 1.0;

    if (GetAsyncKeyState(VK_DOWN) & 0x8000)
        zoomInput -= 1.0;

    double targetZoomVelocity =
        zoomInput * ZOOM_MAX_RATE;

    if (zoomInput != 0.0)
    {
        double zoomDiff =
            targetZoomVelocity - zoomVelocity;

        double maxZoomDelta =
            ZOOM_ACCELERATION * deltaTime;

        if (zoomDiff > maxZoomDelta)
            zoomDiff = maxZoomDelta;

        if (zoomDiff < -maxZoomDelta)
            zoomDiff = -maxZoomDelta;

        zoomVelocity += zoomDiff;
    }
    else
    {
        zoomVelocity *= exp(-ZOOM_DAMPING * deltaTime);

        if (fabs(zoomVelocity) < 0.001)
            zoomVelocity = 0.0;
    }

    zoom *= exp(zoomVelocity * deltaTime);

    double inputX = 0.0;
    double inputY = 0.0;

    if (GetAsyncKeyState('A') & 0x8000)
        inputX -= 1.0;

    if (GetAsyncKeyState('D') & 0x8000)
        inputX += 1.0;

    if (GetAsyncKeyState('W') & 0x8000)
        inputY += 1.0;

    if (GetAsyncKeyState('S') & 0x8000)
        inputY -= 1.0;

    double inputLength =
        sqrt(inputX * inputX + inputY * inputY);

    if (inputLength > 0.0)
    {
        inputX /= inputLength;
        inputY /= inputLength;
    }

    double targetVelocityX =
        inputX * PAN_SPEED;

    double targetVelocityY =
        inputY * PAN_SPEED;

    double smoothing =
        1.0 - exp(-PAN_SMOOTHING_RATE * deltaTime);

    panVelocityX +=
        (targetVelocityX - panVelocityX) * smoothing;

    panVelocityY +=
        (targetVelocityY - panVelocityY) * smoothing;

    double movementScale = 3.5 / zoom;

    centerX = ddAdd(
        centerX,
        ddFromDouble(
            panVelocityX * movementScale * deltaTime
        )
    );

    centerY = ddAdd(
        centerY,
        ddFromDouble(
            panVelocityY * movementScale * deltaTime
        )
    );

    if (zoom < 0.25)
    {
        zoom = 0.25;
        zoomVelocity = 0.0;
    }

    if (zoom > ZOOM_SAFETY_LIMIT)
    {
        zoom = ZOOM_SAFETY_LIMIT;
        zoomVelocity = 0.0;
    }
}

CpuWorkerPool* globalCpuPool = nullptr;

bool cpuBusy = false;
bool gpuBusy = false;

bool cpuJobPartial = false;
bool gpuJobPartial = false;

bool syncFrameActive = false;
bool cpuSyncReady = false;
bool gpuSyncReady = false;

RenderConfig cpuJobConfig = {};
RenderConfig gpuJobConfig = {};
RenderConfig syncFrameConfig = {};

std::chrono::steady_clock::time_point cpuJobStartTime;
std::chrono::steady_clock::time_point gpuJobStartTime;

cudaStream_t renderStream = nullptr;
cudaEvent_t gpuDoneEvent = nullptr;

bool startCpuJob(
    CpuWorkerPool& cpuPool,
    const RenderConfig& config,
    bool partial
)
{
    if (config.cpuBlockRows <= 0)
        return true;

    if (cpuBusy)
        return false;

    cpuJobConfig = config;
    cpuJobPartial = partial;
    cpuJobStartTime = std::chrono::steady_clock::now();

    uchar4* output = cpuPixels.data();

    cpuPool.dispatch(
        config.cpuStartBlockRow,
        config.totalBlockRows,
        [output, config](int blockRow)
        {
            renderCpuBlockRow(
                output,
                config,
                blockRow
            );
        }
    );

    cpuBusy = true;

    return true;
}

bool startGpuJob(
    const RenderConfig& config,
    bool partial
)
{
    if (config.gpuBlockRows <= 0)
        return true;

    if (gpuBusy)
        return false;

    gpuJobConfig = config;
    gpuJobPartial = partial;
    gpuJobStartTime = std::chrono::steady_clock::now();

    dim3 block(16, 16);

    dim3 grid(
        (config.blockColumns + 15) / 16,
        (config.gpuBlockRows + 15) / 16
    );

    mandelbrotKernel<<<grid, block, 0, renderStream>>>(
        devicePixels,
        config.width,
        config.height,
        config.blockSize,
        config.blockColumns,
        0,
        config.gpuBlockRows,
        config.cx,
        config.cy,
        config.zoomValue,
        config.iterations,
        config.highPrecision
    );

    if (!checkCuda(cudaGetLastError()))
        return false;

    size_t gpuBytes =
        (size_t)config.gpuPixelRows *
        config.width *
        sizeof(uchar4);

    if (!checkCuda(cudaMemcpyAsync(
        gpuHostPixels,
        devicePixels,
        gpuBytes,
        cudaMemcpyDeviceToHost,
        renderStream)))
        return false;

    if (!checkCuda(cudaEventRecord(
        gpuDoneEvent,
        renderStream)))
        return false;

    gpuBusy = true;

    return true;
}

void finishCpuJob()
{
    if (!cpuBusy || !globalCpuPool->isDone())
        return;

    cpuBusy = false;

    auto finishTime = std::chrono::steady_clock::now();

    double milliseconds =
        std::chrono::duration<double, std::milli>(
            finishTime - cpuJobStartTime
        ).count();

    recordCpuRate(
        cpuJobConfig.cpuBlockRows,
        milliseconds
    );

    updateAutomaticBalance();

    if (cpuJobPartial)
    {
        publishRegion(
            cpuPixels.data(),
            cpuJobConfig.cpuPixelStart,
            cpuJobConfig.cpuPixelEnd,
            cpuJobConfig
        );
    }
    else
    {
        cpuSyncReady = true;
    }
}

bool finishGpuJob()
{
    if (!gpuBusy)
        return true;

    cudaError_t result = cudaEventQuery(gpuDoneEvent);

    if (result == cudaErrorNotReady)
        return true;

    if (result != cudaSuccess)
    {
        checkCuda(result);
        return false;
    }

    gpuBusy = false;

    auto finishTime = std::chrono::steady_clock::now();

    double milliseconds =
        std::chrono::duration<double, std::milli>(
            finishTime - gpuJobStartTime
        ).count();

    recordGpuRate(
        gpuJobConfig.gpuBlockRows,
        milliseconds
    );

    updateAutomaticBalance();

    if (gpuJobPartial)
    {
        publishRegion(
            gpuHostPixels,
            0,
            gpuJobConfig.gpuPixelRows,
            gpuJobConfig
        );
    }
    else
    {
        gpuSyncReady = true;
    }

    return true;
}

void finishSynchronousFrame()
{
    if (!syncFrameActive)
        return;

    if (!cpuSyncReady || !gpuSyncReady)
        return;

    publishFullFrame(syncFrameConfig);

    syncFrameActive = false;
}

void startSynchronousFrame(
    CpuWorkerPool& cpuPool,
    const RenderConfig& config
)
{
    syncFrameConfig = config;

    cpuSyncReady = config.cpuBlockRows <= 0;
    gpuSyncReady = config.gpuBlockRows <= 0;

    syncFrameActive = true;

    if (config.cpuBlockRows > 0)
    {
        if (!startCpuJob(cpuPool, config, false))
            syncFrameActive = false;
    }

    if (config.gpuBlockRows > 0)
    {
        if (!startGpuJob(config, false))
            syncFrameActive = false;
    }

    finishSynchronousFrame();
}

LRESULT CALLBACK WindowProcedure(
    HWND hwnd,
    UINT message,
    WPARAM wParam,
    LPARAM lParam
)
{
    switch (message)
    {
    case WM_SLIDER_CHANGED:
        if (wParam == ID_ITERATIONS)
            maxIterations = (int)lParam;

        if (wParam == ID_RESOLUTION)
            resolutionBlockSize = (int)lParam;

        if (wParam == ID_CPU_SHARE && !autoBalanceEnabled)
            requestCpuShare((int)lParam);

        updateLabels();
        return 0;

    case WM_COMMAND:
        if (HIWORD(wParam) == BN_CLICKED)
        {
            int controlId = LOWORD(wParam);

            if (controlId == ID_AUTO_BUTTON)
            {
                autoBalanceEnabled = !autoBalanceEnabled;

                EnableWindow(
                    cpuShareSlider,
                    autoBalanceEnabled ? FALSE : TRUE
                );

                if (autoBalanceEnabled)
                {
                    lastAutoCpuVersion = cpuRateVersion;
                    lastAutoGpuVersion = gpuRateVersion;

                    if (appliedCpuShare == 0 ||
                        appliedCpuShare == 100)
                    {
                        requestCpuShare(25);
                    }
                }

                updateButtonTexts();
                updateLabels();

                SetFocus(hwnd);
                return 0;
            }

            if (controlId == ID_PARTIAL_BUTTON)
            {
                partialUpdatesEnabled =
                    !partialUpdatesEnabled;

                updateButtonTexts();

                SetFocus(hwnd);
                return 0;
            }
        }

        break;

    case WM_SIZE:
        if (statusLabel)
            layoutControls(hwnd);

        return 0;

    case WM_CTLCOLORSTATIC:
    {
        HDC dc = (HDC)wParam;

        SetTextColor(dc, RGB(220, 235, 245));
        SetBkMode(dc, TRANSPARENT);

        return (LRESULT)GetStockObject(BLACK_BRUSH);
    }

    case WM_ERASEBKGND:
        return 1;

    case WM_PAINT:
    {
        PAINTSTRUCT ps;
        HDC dc = BeginPaint(hwnd, &ps);

        RECT rect;
        GetClientRect(hwnd, &rect);

        if (!displayImageAvailable ||
            displayWidth <= 0 ||
            displayHeight <= 0)
        {
            FillRect(
                dc,
                &ps.rcPaint,
                (HBRUSH)GetStockObject(BLACK_BRUSH)
            );
        }
        else
        {
            int imageTop = isFullscreen ? 0 : IMAGE_TOP;

            int controlsHeight =
                isFullscreen ? 0 : CONTROL_AREA_HEIGHT;

            int imageHeight =
                rect.bottom - imageTop - controlsHeight;

            if (imageHeight < 1)
                imageHeight = 1;

            if (ps.rcPaint.top < imageTop)
            {
                RECT topRect = ps.rcPaint;

                if (topRect.bottom > imageTop)
                    topRect.bottom = imageTop;

                if (topRect.bottom > topRect.top)
                {
                    FillRect(
                        dc,
                        &topRect,
                        (HBRUSH)GetStockObject(BLACK_BRUSH)
                    );
                }
            }

            int imageBottom = imageTop + imageHeight;

            if (ps.rcPaint.bottom > imageBottom)
            {
                RECT bottomRect = ps.rcPaint;

                if (bottomRect.top < imageBottom)
                    bottomRect.top = imageBottom;

                if (bottomRect.bottom > bottomRect.top)
                {
                    FillRect(
                        dc,
                        &bottomRect,
                        (HBRUSH)GetStockObject(BLACK_BRUSH)
                    );
                }
            }

            SetStretchBltMode(dc, COLORONCOLOR);

            StretchDIBits(
                dc,
                0,
                imageTop,
                rect.right,
                imageHeight,
                0,
                0,
                displayWidth,
                displayHeight,
                displayPixels.data(),
                &bitmapInfo,
                DIB_RGB_COLORS,
                SRCCOPY
            );
        }

        EndPaint(hwnd, &ps);
        return 0;
    }

    case WM_DESTROY:
        PostQuitMessage(0);
        return 0;
    }

    return DefWindowProcA(
        hwnd,
        message,
        wParam,
        lParam
    );
}

