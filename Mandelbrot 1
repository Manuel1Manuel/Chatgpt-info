void updateSliderFromMouse(
    HWND hwnd,
    SliderData* data,
    int mouseX
)
{
    if (!data)
        return;

    RECT rect;
    GetClientRect(hwnd, &rect);

    int left = 12;
    int right = rect.right - 12;

    if (right <= left)
        return;

    if (mouseX < left)
        mouseX = left;

    if (mouseX > right)
        mouseX = right;

    double fraction =
        (double)(mouseX - left) / (double)(right - left);

    int newValue = data->minimum +
        (int)std::lround(
            fraction * (data->maximum - data->minimum)
        );

    if (newValue == data->value)
        return;

    data->value = newValue;

    InvalidateRect(hwnd, nullptr, FALSE);

    SendMessageA(
        GetParent(hwnd),
        WM_SLIDER_CHANGED,
        (WPARAM)data->id,
        (LPARAM)data->value
    );
}

LRESULT CALLBACK SliderProcedure(
    HWND hwnd,
    UINT message,
    WPARAM wParam,
    LPARAM lParam
)
{
    if (message == WM_NCCREATE)
    {
        CREATESTRUCTA* createInfo =
            (CREATESTRUCTA*)lParam;

        SetWindowLongPtrA(
            hwnd,
            GWLP_USERDATA,
            (LONG_PTR)createInfo->lpCreateParams
        );

        return TRUE;
    }

    SliderData* data =
        (SliderData*)GetWindowLongPtrA(
            hwnd,
            GWLP_USERDATA
        );

    switch (message)
    {
    case WM_ERASEBKGND:
        return 1;

    case WM_SETCURSOR:
        SetCursor(LoadCursorA(nullptr, IDC_HAND));
        return TRUE;

    case WM_LBUTTONDOWN:
        if (data)
        {
            data->dragging = true;
            SetCapture(hwnd);
            SetFocus(GetParent(hwnd));

            updateSliderFromMouse(
                hwnd,
                data,
                GET_X_LPARAM(lParam)
            );
        }

        return 0;

    case WM_MOUSEMOVE:
        if (data && data->dragging)
        {
            updateSliderFromMouse(
                hwnd,
                data,
                GET_X_LPARAM(lParam)
            );
        }

        return 0;

    case WM_LBUTTONUP:
        if (data)
        {
            updateSliderFromMouse(
                hwnd,
                data,
                GET_X_LPARAM(lParam)
            );

            data->dragging = false;

            if (GetCapture() == hwnd)
                ReleaseCapture();
        }

        return 0;

    case WM_CAPTURECHANGED:
        if (data)
            data->dragging = false;

        return 0;

    case WM_PAINT:
    {
        PAINTSTRUCT ps;
        HDC dc = BeginPaint(hwnd, &ps);

        RECT rect;
        GetClientRect(hwnd, &rect);

        FillRect(
            dc,
            &rect,
            (HBRUSH)GetStockObject(BLACK_BRUSH)
        );

        if (data)
        {
            int width = rect.right;
            int height = rect.bottom;

            int left = 12;
            int right = width - 12;
            int centerY = height / 2;

            if (right > left)
            {
                double fraction = 0.0;

                if (data->maximum > data->minimum)
                {
                    fraction =
                        (double)(data->value - data->minimum) /
                        (double)(data->maximum - data->minimum);
                }

                if (fraction < 0.0)
                    fraction = 0.0;

                if (fraction > 1.0)
                    fraction = 1.0;

                int thumbX =
                    left +
                    (int)std::lround(
                        fraction * (right - left)
                    );

                HPEN trackPen = CreatePen(
                    PS_SOLID,
                    1,
                    RGB(48, 60, 76)
                );

                HBRUSH trackBrush = CreateSolidBrush(
                    RGB(38, 48, 62)
                );

                HGDIOBJ oldPen =
                    SelectObject(dc, trackPen);

                HGDIOBJ oldBrush =
                    SelectObject(dc, trackBrush);

                RoundRect(
                    dc,
                    left,
                    centerY - 3,
                    right,
                    centerY + 4,
                    8,
                    8
                );

                SelectObject(dc, oldPen);
                SelectObject(dc, oldBrush);

                DeleteObject(trackPen);
                DeleteObject(trackBrush);

                if (thumbX > left)
                {
                    HPEN fillPen = CreatePen(
                        PS_SOLID,
                        1,
                        RGB(0, 190, 225)
                    );

                    HBRUSH fillBrush = CreateSolidBrush(
                        RGB(0, 160, 205)
                    );

                    oldPen = SelectObject(dc, fillPen);
                    oldBrush = SelectObject(dc, fillBrush);

                    RoundRect(
                        dc,
                        left,
                        centerY - 3,
                        thumbX + 1,
                        centerY + 4,
                        8,
                        8
                    );

                    SelectObject(dc, oldPen);
                    SelectObject(dc, oldBrush);

                    DeleteObject(fillPen);
                    DeleteObject(fillBrush);
                }

                HPEN thumbPen = CreatePen(
                    PS_SOLID,
                    2,
                    RGB(170, 245, 255)
                );

                HBRUSH thumbBrush = CreateSolidBrush(
                    RGB(0, 180, 220)
                );

                oldPen = SelectObject(dc, thumbPen);
                oldBrush = SelectObject(dc, thumbBrush);

                Ellipse(
                    dc,
                    thumbX - 9,
                    centerY - 9,
                    thumbX + 10,
                    centerY + 10
                );

                SelectObject(dc, oldPen);
                SelectObject(dc, oldBrush);

                DeleteObject(thumbPen);
                DeleteObject(thumbBrush);
            }
        }

        EndPaint(hwnd, &ps);
        return 0;
    }
    }

    return DefWindowProcA(
        hwnd,
        message,
        wParam,
        lParam
    );
}

